// kyrr's user interface: the tray icon and one small window that shows the
// first-run setup or the main panel. All texts are English source strings
// translated through the bundled translations in ui/lang.

import { Button, ComboBox, Switch, Slider, ProgressIndicator, ScrollView, Palette } from "std-widgets.slint";

// detached: Windows (an update, a driver) took kyrr off the microphone.
// unsupported: this PC cannot run the filter (Windows on ARM, Linux without
// PipeWire).
export enum FilterState { checking, running, off, passthrough, not-attached, not-installed, setting-up, error, detached, unsupported }
export enum DictationState { off, no-model, downloading, loading, ready, recording, transcribing, error }
export enum ProbeState { idle, recording, before, after }
// downloading and installing: "Update now" at work; download-failed
// offers it again, and the download page.
export enum UpdateState { idle, checking, current, available, failed, downloading, installing, download-failed }

export global AppState {
    // Noise removal
    in-out property <bool> filter-enabled: true;
    in-out property <int> strength-index: 1; // 0 gentle, 1 medium, 2 strong
    in-out property <int> model-index;       // 0 thorough (large), 1 lean (small)
    in property <bool> model-switching;
    // The filter fell back to ONNX Runtime: the CPU lacks AVX2, Lean suits it.
    in property <bool> old-cpu;
    // Linux: the filter is kyrr's own microphone, there is no installer, and
    // the desktop may have no tray.
    in property <bool> linux;
    in property <bool> tray: true;
    // Without a tray, closing minimizes where the desktop can (not tiling ones).
    in property <bool> can-minimize: true;
    in property <FilterState> filter-state: FilterState.checking;
    in property <string> filter-detail; // technical, not translated
    in property <[string]> microphones;
    in-out property <int> mic-index;
    in property <string> attached-mic;
    // The filtered microphone is unplugged; this one could take over ("" if none).
    in property <string> move-to;
    in property <bool> move-unplugged;

    // Live: level and the before/after probe
    in property <bool> mic-active;
    // The microphone is in use but delivers nothing at all: muted, most likely.
    in property <bool> mic-silent;
    // Windows has the microphone muted.
    in-out property <bool> mic-muted;
    // A microphone that just showed up.
    in property <string> connected-name;
    in property <float> level-before; // 0..1
    in property <float> level-after;
    in property <ProbeState> probe-state: ProbeState.idle;
    in property <bool> has-probe;
    in property <string> probe-error;
    // The mic plays live on the headphones.
    in property <bool> listening;
    // The red note at the bottom of the main page, one at a time:
    // 0 none, 1 mic too quiet, 2 mic too loud, 3 still listening.
    in property <int> alert;

    // Voice: sound, S sounds and volume, shaped in the audio filter
    in-out property <bool> voice-enabled: true;
    in-out property <int> look-index;    // neutral, warm, clear, bright, custom
    in-out property <float> body-db;     // the custom sound, -6..6 dB
    in-out property <float> presence-db;
    in-out property <float> air-db;
    in-out property <bool> low-cut: true;
    in-out property <bool> pops;
    in-out property <bool> auto-level;
    in property <float> level-gain; // what it adds right now, dB
    // The settings page shows everything, not just the basics.
    in-out property <bool> advanced;
    in-out property <int> deesser-index;       // off, light, medium, strong
    in-out property <int> compressor-index: 2; // off, light, medium, strong
    in property <bool> voice-is-default: true;

    // Dictation
    in-out property <bool> dictation-enabled: true;
    in-out property <int> language-index; // 0 German, 1 English
    in property <DictationState> dictation-state: DictationState.off;
    in property <float> download-progress;
    in property <string> download-size;
    in property <string> last-text;
    // What dictation has to say (an error, a hint); "" for nothing.
    in property <string> dictation-message;
    in-out property <int> key-index: 1; // F8, F9, Pause, right Ctrl
    in-out property <bool> key-toggle;  // tap to start and stop instead of holding
    in property <string> key-name: "F9";
    // What the user has to do so the key reaches kyrr (Linux); "" for nothing.
    in property <string> key-note;
    // The desktop owns the key (GNOME, KDE): kyrr's choice of key does nothing.
    in property <bool> key-fixed;
    // The desktop could own the key but has not bound it (dialog cancelled).
    in property <bool> key-unbound;
    // A button for the key in the settings ("Set up key", "Change key"); "" for none.
    in property <string> key-button;
    callback key-button-clicked();
    // The setup walks through the desktop's two questions (GNOME, KDE): the
    // key and the permission to type.
    in property <bool> guide;
    // 0 not asked, 1 the desktop is asking, 2 set up, 3 cancelled.
    in property <int> key-state;
    // The key was pressed since it was set up.
    in property <bool> key-tried;
    // 0 not asked, 1 the desktop is asking, 2 allowed, 3 not allowed.
    in property <int> typing-state;
    callback setup-key();
    callback allow-typing();
    // "Check for updates", on request only.
    in property <UpdateState> update-state;
    in property <string> update-version;
    in property <string> update-url;
    // The new version comes with a short summary of what changed.
    in property <bool> update-has-news;
    // The release's installer; "" when it has none (then only the page).
    in property <bool> update-installable;
    in property <float> update-progress; // 0..1
    // The daily check is on; the user closed the note for this version.
    in-out property <bool> update-auto: true;
    in property <bool> update-dismissed;

    in-out property <bool> autostart;
    // PipeWire is missing (Linux): a button that installs it, and what to
    // say about it ("" for nothing).
    in property <bool> pipewire-button;
    in property <string> pipewire-note;
    callback install-pipewire();
    // How installing it went, a PipewireStep from Rust.
    callback pipewire-step(int);
    in property <string> error-text;
    in property <string> version;

    // 0 is the main view, 1 the settings page.
    in-out property <int> page;
    // Counts up every few seconds; the status line picks its next phrase
    // from it, so one state does not repeat the same sentence.
    in property <int> phrase;
    // False for a moment before the next phrase, so it fades out and in.
    in property <bool> phrase-visible: true;

    callback filter-toggled(bool);
    callback strength-changed(int);
    callback model-changed(int);
    callback probe-record();
    callback probe-play(bool); // false before, true after
    callback probe-reset();
    callback listen-toggled();
    callback voice-toggled(bool);
    callback look-changed(int);
    callback band-changed(int, float); // 0 body, 1 presence, 2 air
    callback low-cut-toggled(bool);
    callback pops-toggled(bool);
    callback auto-level-toggled(bool);
    callback advanced-toggled(bool);
    callback deesser-changed(int);
    callback compressor-changed(int);
    callback voice-reset();
    callback attach-microphone(int);
    callback dictation-toggled(bool);
    callback language-changed(int);
    callback download-model();
    callback cancel-download();
    callback finish-setup();
    callback change-microphone();
    callback autostart-toggled(bool);
    // Puts the window away, like its close button; kyrr keeps running in the tray.
    callback hide();
    // Ends kyrr for good, like the tray menu's "Quit".
    callback quit-app();
    // Switches Windows' mute off the microphone.
    callback unmute();
    callback page-changed();
    callback dictation-retry();
    callback repair();
    callback move-to-default();
    callback key-changed(int);
    callback key-toggle-changed(bool);
    callback open-licenses();
    callback check-updates();
    callback open-update();
    callback show-news();
    // What the running version brought (from the NEWS built into the app).
    callback show-current-news();
    callback install-update();
    callback update-auto-toggled(bool);
    callback dismiss-update();
    callback skip-setup();
}

// The tray has its own properties: globals are per component instance, so
// the app wires tray and window separately.
export component Tray inherits SystemTrayIcon {
    in property <bool> recording;
    in property <bool> active;
    in property <bool> filter-enabled;
    in property <bool> voice-enabled;
    in property <bool> dictation-enabled;
    in property <bool> dictation-ready;
    in property <string> key-name: "F9";
    // A newer version found ("" for none).
    in property <string> update-version;
    callback open();
    callback install-update();
    callback toggle-filter();
    callback toggle-voice();
    callback toggle-dictation();
    callback quit();
    icon: recording ? @image-url("icons/kyrr-recording-32.png") : active ? @image-url("icons/kyrr-32.png") : @image-url("icons/kyrr-off-32.png");
    tooltip: "kyrr · " + (root.filter-enabled ? @tr("noise filter on") : @tr("noise filter off"))
        + (root.dictation-ready ? " · " + @tr("{} ready", root.key-name) : "")
        + (root.update-version != "" ? " · " + @tr("update available") : "");
    // Some panels list tray icons by title.
    title: "kyrr";
    clicked => { root.open(); }
    Menu {
        MenuItem {
            title: @tr("Open kyrr");
            activated => { root.open(); }
        }
        MenuItem {
            title: root.filter-enabled ? @tr("Noise removal: on") : @tr("Noise removal: off");
            activated => { root.toggle-filter(); }
        }
        MenuItem {
            title: root.voice-enabled ? @tr("Voice: on") : @tr("Voice: off");
            activated => { root.toggle-voice(); }
        }
        MenuItem {
            title: root.dictation-enabled ? @tr("Turn dictation off") : @tr("Turn dictation on");
            activated => { root.toggle-dictation(); }
        }
        if root.update-version != "": MenuItem {
            title: @tr("Install update {}", root.update-version);
            activated => { root.install-update(); }
        }
        MenuItem {
            title: @tr("Quit");
            activated => { root.quit(); }
        }
    }
}

component Caption inherits Text {
    color: Palette.foreground.with-alpha(0.65);
    font-size: 12px;
    wrap: word-wrap;
}

// A short, plain explanation of the option chosen above it.
component Hint inherits Text {
    // 0.7 keeps small text readable (contrast), still quieter than captions.
    color: Palette.foreground.with-alpha(0.7);
    font-size: 11px;
    wrap: word-wrap;
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
}

component Card inherits Rectangle {
    background: Palette.alternate-background;
    border-radius: 10px;
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        @children
    }
}

component Separator inherits Rectangle {
    height: 1px;
    background: Palette.border.with-alpha(0.6);
}

// A row of choices, one selected. Tab focuses it, the arrow keys move the
// choice; screen readers hear each option as a radio button.
component Segmented inherits FocusScope {
    in property <[string]> options;
    in-out property <int> selected;
    callback changed(int);

    function choose(i: int) {
        if (root.enabled && i >= 0 && i < root.options.length && i != root.selected) {
            root.selected = i;
            root.changed(i);
        }
    }

    key-pressed(event) => {
        if (event.text == Key.LeftArrow) {
            root.choose(root.selected - 1);
            return accept;
        }
        if (event.text == Key.RightArrow) {
            root.choose(root.selected + 1);
            return accept;
        }
        return reject;
    }

    HorizontalLayout {
        spacing: 6px;
        for option[i] in root.options: Rectangle {
            height: 28px;
            border-radius: 6px;
            background: i == root.selected ? Palette.accent-background : Palette.control-background;
            border-width: root.has-focus && i == root.selected ? 2px : 1px;
            border-color: root.has-focus && i == root.selected ? Palette.foreground : Palette.border;
            opacity: root.enabled ? 1 : 0.5;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: i == root.selected;
            accessible-action-default => { root.choose(i); }
            Text {
                text: option;
                color: i == root.selected ? Palette.accent-foreground : Palette.control-foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.enabled;
                clicked => {
                    root.focus();
                    root.choose(i);
                }
            }
        }
    }
}

// Grey: what the microphone hears. Accent line: what apps get.
component Meter inherits Rectangle {
    in property <float> before;
    in property <float> after;
    height: 10px;
    border-radius: 5px;
    background: Palette.control-background;
    border-width: 1px;
    border-color: Palette.border;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.before, 0, 1);
        height: parent.height;
        border-radius: 5px;
        background: Palette.foreground.with-alpha(0.18);
        animate width { duration: 90ms; }
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * clamp(root.after, 0, 1);
        height: 4px;
        border-radius: 2px;
        background: Palette.accent-background;
        animate width { duration: 90ms; }
    }
}

// A small wave in the logo's colour next to the status line: it sways
// slowly while kyrr works, barely breathes while it waits, and lies still
// when everything is off (then nothing is redrawn at all). It steps on a
// timer instead of every frame: a frame-by-frame wave kept a whole core of
// an older laptop busy redrawing the window.
component Pulse inherits Rectangle {
    in property <bool> working;
    in property <bool> waiting;
    property <bool> moving: root.working || root.waiting;
    // Milliseconds of movement so far.
    property <float> t: 0;
    Timer {
        interval: root.working ? 50ms : 200ms;
        running: root.moving;
        triggered => { root.t += self.interval / 1ms; }
    }
    // Seconds per sway; slow on purpose, this is kyrr after all.
    property <float> period: root.working ? 2200 : 4500;
    property <float> depth: root.working ? 1 : 0.3;
    width: 14px;
    height: 16px;
    for bar[i] in 4: Rectangle {
        property <float> level: root.moving ? root.depth * (0.5 + 0.5 * sin(root.t / root.period * 360deg + i * 75deg)) : 0;
        x: i * 4px;
        width: 2px;
        height: 2px + 10px * self.level;
        y: (root.height - self.height) / 2;
        border-radius: 1px;
        background: Palette.color-scheme == ColorScheme.dark ? #5eead4 : #14b8a6;
        opacity: root.moving ? 0.85 : 0.4;
    }
}

// What kyrr is up to right now, in one loose sentence under the name, small
// and in italics so it reads as a remark, not a setting. Long-lasting states
// rotate through a few phrases to pass the time; errors and setup stay put.
component StatusLine inherits HorizontalLayout {
    pure function pick(list: [string]) -> string {
        return list[AppState.phrase.mod(list.length)];
    }
    property <float> percent: round(AppState.download-progress * 100);

    pure function status() -> string {
        if (AppState.filter-state == FilterState.setting-up) { return @tr("Setting things up… sound takes a short break."); }
        if (AppState.mic-active && AppState.mic-silent) { return @tr("Your mic delivers pure silence. Muted?"); }
        if (AppState.probe-state == ProbeState.recording) {
            return pick([
                @tr("Ten seconds of fame."),
                @tr("Noise for science."),
                @tr("Open-mic night, short edition."),
                @tr("Shopping-list reading hour."),
            ]);
        }
        if (AppState.probe-state == ProbeState.before) { return @tr("Before: this is you without kyrr."); }
        if (AppState.probe-state == ProbeState.after) { return @tr("After: same take, with kyrr."); }
        if (AppState.dictation-state == DictationState.recording) {
            return pick([
                @tr("All ears."),
                @tr("Mumbling permitted."),
                @tr("Listening intently."),
            ]);
        }
        if (AppState.dictation-state == DictationState.transcribing) {
            return pick([
                @tr("Mumble translation."),
                @tr("Speed typing."),
                @tr("Word sorting."),
            ]);
        }
        if (AppState.dictation-state == DictationState.downloading) {
            return pick([
                @tr("{}% · Patience test.", percent),
                @tr("{}% · Coffee-break length.", percent),
                @tr("{}% · Progress-bar hypnosis.", percent),
                @tr("{}% · Chunky delivery.", percent),
            ]);
        }
        if (AppState.model-switching) {
            return pick([
                @tr("Brain transplant."),
                @tr("Neuron relocation."),
                @tr("Model swap break."),
            ]);
        }
        if (AppState.filter-state == FilterState.not-installed) { return @tr("The kyrr filter is missing. Reinstall, please."); }
        if (AppState.filter-state == FilterState.detached) { return @tr("Windows took kyrr off the mic. Repair below."); }
        if (AppState.filter-state == FilterState.not-attached) { return @tr("Pick a microphone and off we go."); }
        if (AppState.filter-state == FilterState.error) { return @tr("Oops, something went wrong. Details below."); }
        if (AppState.filter-state == FilterState.passthrough) { return @tr("Oops, the filter is stuck. Your mic passes through as it is."); }
        if (!AppState.filter-enabled && !AppState.voice-enabled && AppState.filter-state != FilterState.unsupported) { return @tr("Day off. Everything is off."); }
        if (AppState.mic-active) {
            if (!AppState.filter-enabled) { return @tr("Noise allowed, voice polished."); }
            return pick([
                @tr("Noise bouncer on duty."),
                @tr("Dog eraser."),
                @tr("Fan whisperer."),
                @tr("Quiet zone management."),
                @tr("Drill defence."),
                @tr("Voice-first policy."),
                @tr("Coffee machine censorship."),
                @tr("Noise disposal."),
                @tr("Chair creak swallower."),
                @tr("Noise quarantine."),
                @tr("Slurpless."),
                @tr("Barkblocked."),
                @tr("Vacuumexiled."),
                @tr("Drillnope."),
                @tr("Chewproof."),
                @tr("Burpinsured."),
                @tr("Fanmuzzled."),
                @tr("Keyclackfree."),
                @tr("Sniffleproof."),
                @tr("Leafblowerbanned."),
                @tr("Coworkerpuffstop."),
                @tr("Babywailbreak."),
                @tr("Jackhammerhushed."),
                @tr("Snoreproof."),
                @tr("Flushfree."),
                @tr("Doorbelldeaf."),
                @tr("Mowermuzzled."),
                @tr("Hiccupshielded."),
                @tr("Sneezeswallowed."),
            ]);
        }
        return pick([
            @tr("On-call napping."),
            @tr("Mic waiting room."),
            @tr("Thumb-twiddling mode."),
            @tr("Idle serenity."),
            @tr("Alert nap."),
            @tr("Stockpiling silence."),
        ]);
    }

    // The text lines up with the name and sits close under it (pulled up
    // into the page layout's spacing); the wave follows right after it.
    padding-left: 38px;
    padding-top: -10px;
    spacing: 8px;
    property <bool> working: AppState.mic-active || AppState.probe-state != ProbeState.idle || AppState.model-switching
        || AppState.dictation-state == DictationState.recording || AppState.dictation-state == DictationState.transcribing
        || AppState.dictation-state == DictationState.downloading || AppState.filter-state == FilterState.setting-up;
    property <bool> waiting: (AppState.filter-enabled || AppState.voice-enabled)
        && (AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking);
    Text {
        horizontal-stretch: 0;
        text: root.status();
        font-size: 12px;
        font-italic: true;
        color: Palette.foreground;
        opacity: AppState.phrase-visible ? 0.6 : 0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
        wrap: word-wrap;
        vertical-alignment: top;
        // One line always, so the cards below do not move when it is empty;
        // two for a long message (Slint measures wrapped text in this row as
        // one line, so the room is made here).
        min-height: root.status().character-count > 44 ? 32px : 16px;
    }
    Pulse {
        working: root.working;
        waiting: root.waiting;
    }
    Rectangle { }
}

// A main function's name and its switch. The one-line state below it is a
// direct child of the card (see the note in MainWindow).
component RowHead inherits HorizontalLayout {
    in property <string> title;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    callback toggled(bool);
    Heading { text: root.title; vertical-alignment: center; }
    Rectangle { }
    Switch {
        checked <=> root.checked;
        enabled: root.enabled;
        accessible-label: root.title;
        toggled => { root.toggled(self.checked); }
    }
}

component NoiseCard inherits Card {
    property <bool> attached: AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking;
    RowHead {
        title: @tr("Remove background noise");
        enabled: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
            && AppState.filter-state != FilterState.unsupported;
        checked <=> AppState.filter-enabled;
        toggled(on) => { AppState.filter-toggled(on); }
    }
    Caption {
        text: root.attached ? (AppState.filter-enabled ? @tr("Just your voice. Keyboard, fan and dog stay outside.") : @tr("Off. Your mic passes through as it is."))
            : AppState.filter-state == FilterState.detached ? @tr("Windows took kyrr off {} (an update, most likely).", AppState.attached-mic)
            : AppState.filter-state == FilterState.passthrough ? @tr("The filter could not start and passes the microphone through.")
            : AppState.filter-state == FilterState.not-attached ? @tr("No microphone set up yet.")
            : AppState.filter-state == FilterState.not-installed ? @tr("kyrr's audio filter is not installed. Please reinstall kyrr.")
            : AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("PipeWire is not running, and kyrr needs it. Dictation works.") : @tr("Not on ARM processors yet, sorry. Dictation works."))
            : AppState.filter-state == FilterState.setting-up ? @tr("Setting up… sound pauses for a moment.")
            : AppState.error-text;
    }
    if AppState.filter-state == FilterState.unsupported && AppState.pipewire-button: Button {
        text: @tr("Set up PipeWire");
        primary: true;
        clicked => { AppState.install-pipewire(); }
    }
    if AppState.filter-state == FilterState.unsupported && AppState.pipewire-note != "": Hint { text: AppState.pipewire-note; }
    if AppState.filter-state == FilterState.not-attached: Button {
        text: @tr("Set up microphone");
        primary: true;
        clicked => { AppState.change-microphone(); }
    }
    if AppState.filter-state == FilterState.detached: Button {
        text: @tr("Repair");
        primary: true;
        clicked => { AppState.repair(); }
    }
    if AppState.move-to != "" && AppState.move-unplugged: Hint { text: @tr("Your microphone is not plugged in."); }
    if AppState.move-to != "" && !AppState.move-unplugged: Hint {
        text: AppState.linux ? @tr("Your system uses another microphone now.") : @tr("Windows uses another microphone now.");
    }
    if AppState.move-to != "": Button {
        text: @tr("Use {} instead", AppState.move-to);
        clicked => { AppState.move-to-default(); }
    }
}

component VoiceCard inherits Card {
    property <bool> available: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
        && AppState.filter-state != FilterState.unsupported;
    RowHead {
        title: @tr("Improve voice");
        enabled: root.available;
        checked <=> AppState.voice-enabled;
        toggled(on) => { AppState.voice-toggled(on); }
    }
    Caption {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire too.") : @tr("Not on ARM processors yet either."))
            : !root.available ? @tr("Needs a microphone first.")
            : AppState.voice-enabled ? @tr("A bit of polish for your voice.")
            : @tr("Off. Your voice stays as it is.");
    }
}

component DictationCard inherits Card {
    // The setup asks for the key itself, below the card.
    in property <bool> in-setup;
    RowHead {
        title: @tr("Dictation");
        checked <=> AppState.dictation-enabled;
        toggled(on) => { AppState.dictation-toggled(on); }
    }
    Caption {
        text: AppState.dictation-state == DictationState.off ? @tr("Off. {} does nothing.", AppState.key-name)
            : AppState.dictation-state == DictationState.no-model ? @tr("One download first ({}), then it is yours.", AppState.download-size)
            : AppState.dictation-state == DictationState.downloading ? @tr("Downloading the speech model… {}%", round(AppState.download-progress * 100))
            : AppState.dictation-state == DictationState.loading ? @tr("Loading the speech model…")
            : AppState.dictation-state == DictationState.ready && AppState.key-unbound && !root.in-setup ? @tr("{} is not set up yet: kyrr needs your desktop's OK for it.", AppState.key-name)
            : AppState.dictation-state == DictationState.ready && AppState.key-note != "" && !(root.in-setup && AppState.guide) ? @tr("Dictate with your key, the text lands at your cursor. Setting up the key: see Settings.")
            : AppState.dictation-state == DictationState.ready ? (AppState.key-toggle ? @tr("Tap {}, talk, tap again. The text lands at your cursor.", AppState.key-name) : @tr("Hold {}, talk, let go. The text lands at your cursor.", AppState.key-name))
            : AppState.dictation-state == DictationState.recording ? @tr("Listening…")
            : AppState.dictation-state == DictationState.transcribing ? @tr("Writing…")
            : AppState.dictation-message;
    }
    if AppState.dictation-state != DictationState.error && AppState.dictation-message != "": Hint {
        text: AppState.dictation-message;
    }
    if AppState.dictation-state == DictationState.error: Button {
        text: @tr("Try again");
        clicked => { AppState.dictation-retry(); }
    }
    if AppState.dictation-state == DictationState.ready && AppState.key-unbound && !root.in-setup: Button {
        text: AppState.key-button;
        primary: true;
        clicked => { AppState.key-button-clicked(); }
    }
    if AppState.dictation-state == DictationState.downloading: HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            ProgressIndicator { progress: AppState.download-progress; height: 6px; }
        }
        Button { text: @tr("Cancel"); clicked => { AppState.cancel-download(); } }
    }
    if AppState.dictation-state == DictationState.no-model: Button {
        text: @tr("Download");
        primary: true;
        clicked => { AppState.download-model(); }
    }
}

// One band of the custom sound: name, slider, value.
component BandRow {
    in property <string> label;
    in-out property <float> value;
    callback changed(float);
    HorizontalLayout {
        spacing: 8px;
        Caption { text: root.label; width: 64px; vertical-alignment: center; }
        Slider {
            minimum: -6;
            maximum: 6;
            step: 0.5;
            value <=> root.value;
            changed(v) => { root.changed(v); }
        }
        Caption {
            text: (root.value > 0 ? "+" : "") + round(root.value * 10) / 10 + " dB";
            width: 52px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Settings: the choices behind the noise switch.
component NoiseSettings inherits Card {
    pure function strength-hint(i: int) -> string {
        if (i == 0) { return @tr("Takes the worst out and leaves a bit of room. Natural."); }
        if (i == 1) { return @tr("The sweet spot for most rooms."); }
        return @tr("Out with everything but you. Bouncer mode.");
    }
    pure function model-hint(i: int) -> string {
        if (i == 1) { return @tr("A third of the CPU, barely less clean. For old laptops."); }
        return @tr("Cleanest result, a bit more CPU. Default for a reason.");
    }
    property <bool> attached: AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking;

    Heading { text: @tr("Background noise"); }
    if !root.attached: Hint {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire, which is not running.") : @tr("Not on ARM processors yet, sorry.")) : @tr("Set up a microphone first.");
    }
    if root.attached: Caption { text: @tr("Filter strength"); }
    if root.attached: Segmented {
        options: [@tr("Gentle"), @tr("Medium"), @tr("Strong")];
        selected <=> AppState.strength-index;
        changed(i) => { AppState.strength-changed(i); }
    }
    if root.attached: Hint { text: root.strength-hint(AppState.strength-index); }
    if root.attached && AppState.advanced: Caption { text: @tr("Model"); }
    if root.attached && AppState.advanced: Segmented {
        options: [@tr("Thorough"), @tr("Lean")];
        selected <=> AppState.model-index;
        changed(i) => { AppState.model-changed(i); }
    }
    if root.attached && AppState.advanced: Hint { text: root.model-hint(AppState.model-index); }
    if root.attached && AppState.advanced && AppState.old-cpu: Hint { text: @tr("This processor is a bit older: Lean runs smoother on it."); }
}

// Settings: the dictation key and how it works.
component DictationSettings inherits Card {
    Heading { text: @tr("Dictation"); }
    Caption { text: @tr("Key"); }
    // Where the desktop owns the key, its own settings change it.
    if !AppState.key-fixed: Segmented {
        options: ["F8", "F9", "Pause", @tr("Right Ctrl")];
        selected <=> AppState.key-index;
        changed(i) => { AppState.key-changed(i); }
    }
    // Only where kyrr catches the key itself.
    if AppState.key-note == "": Hint { text: @tr("With Ctrl, Alt or Shift held, the key stays with your app."); }
    if AppState.key-note != "": Hint { text: AppState.key-note; }
    if AppState.key-button != "": Button {
        text: AppState.key-button;
        clicked => { AppState.key-button-clicked(); }
    }
    Caption { text: @tr("How"); }
    Segmented {
        options: [@tr("Hold"), @tr("Tap")];
        selected: AppState.key-toggle ? 1 : 0;
        changed(i) => { AppState.key-toggle-changed(i == 1); }
    }
    Hint {
        text: AppState.key-toggle ? @tr("Tap once to start, once more to stop. For long thoughts.")
            : @tr("Hold while you talk, let go when you are done. Walkie-talkie style.");
    }
    Hint { text: @tr("Say “new line” or “new paragraph” for line breaks."); }
}

// Settings: who made what.
component AboutSettings inherits Card {
    // The simple view folds the credits away behind a button.
    in-out property <bool> unfolded;
    property <bool> credits: AppState.advanced || root.unfolded;
    Heading { text: @tr("About"); }
    // The models' credits, as their licenses ask. NVIDIA's sentence stays
    // in English in every language: the license gives it word for word.
    Hint { text: @tr("kyrr is mostly just very good at plugging things together. Built on the work of many."); }
    if root.credits: Hint { text: @tr("Noise removal: DPDFNet by Ceva (Apache-2.0), via Fovty's HushMic."); }
    if root.credits: Hint { text: @tr("German dictation: parakeet-primeline by primeLine AI (CC-BY-4.0), based on NVIDIA Parakeet."); }
    if root.credits: Hint { text: @tr("English dictation: NVIDIA parakeet-unified-en-0.6b, Licensed by NVIDIA Corporation under the NVIDIA Open Model License; ONNX by sherpa-onnx."); }
    if root.credits: Hint { text: @tr("Plus the work of many more not named here. Raising a beer to you all."); }
    // Up to two rows: three buttons side by side overflow the card in German and
    // with wider system fonts, and the window has a fixed width.
    if !AppState.advanced: HorizontalLayout {
        Rectangle { }
        Button {
            text: root.unfolded ? @tr("Less") : @tr("Credits");
            clicked => { root.unfolded = !root.unfolded; }
        }
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle { }
        Button { text: @tr("What's new"); clicked => { AppState.show-current-news(); } }
        Button { text: @tr("Licenses"); clicked => { AppState.open-licenses(); } }
    }
}

// The main view's quiet note that a new version is out, with the one click
// that installs it. Closing it hides it until the next version.
component UpdateBanner inherits Rectangle {
    property <bool> busy: AppState.update-state == UpdateState.downloading || AppState.update-state == UpdateState.installing;
    background: #2ea043.with-alpha(0.12);
    border-color: #2ea043.with-alpha(0.45);
    border-width: 1px;
    border-radius: 10px;
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: 4px; background: #2ea043; }
        }
        Text {
            text: AppState.update-state == UpdateState.downloading ? @tr("Downloading the update… {}%", round(AppState.update-progress * 100))
                : AppState.update-state == UpdateState.installing ? @tr("Installing, kyrr restarts in a moment.")
                : AppState.update-state == UpdateState.download-failed ? @tr("The update did not download.")
                : @tr("Version {} is out.", AppState.update-version);
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !root.busy && AppState.update-has-news: Button {
            text: @tr("What's new");
            horizontal-stretch: 0;
            clicked => { AppState.show-news(); }
        }
        if !root.busy && AppState.update-installable: Button {
            text: AppState.update-state == UpdateState.download-failed ? @tr("Try again") : @tr("Update");
            primary: true;
            horizontal-stretch: 0;
            clicked => { AppState.install-update(); }
        }
        if !root.busy && !AppState.update-installable: Button {
            text: @tr("Download page");
            horizontal-stretch: 0;
            clicked => { AppState.open-update(); }
        }
        if !root.busy: Rectangle {
            width: 24px;
            horizontal-stretch: 0;
            accessible-role: button;
            accessible-label: @tr("Not now");
            accessible-action-default => { AppState.dismiss-update(); }
            Text {
                // × (not ✕): every font has it.
                text: "×";
                font-size: 20px;
                color: close.has-hover ? Palette.foreground : Palette.foreground.with-alpha(0.55);
            }
            close := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppState.dismiss-update(); }
            }
        }
    }
}

// Sends the window away; everything else keeps running in the tray.
// A button in warning red, for something that is running and should not be
// forgotten.
component AlertButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    min-height: 32px;
    min-width: label.preferred-width + 24px;
    border-radius: 4px;
    background: touch.pressed ? #b4282c : touch.has-hover ? #cf3338 : #e5484d;
    label := Text {
        text: root.text;
        color: white;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The small red note at the bottom of the main page. Always one line high,
// empty or not, so the window keeps its height however many notes there are.
component AlertLine inherits Text {
    pure function note() -> string {
        if (AppState.alert == 1) { return (AppState.linux ? @tr("Mic very quiet. Turn it up in your sound settings.") : @tr("Mic very quiet. Turn it up in Windows.")); }
        if (AppState.alert == 2) { return (AppState.linux ? @tr("Mic too loud. Turn it down in your sound settings.") : @tr("Mic too loud. Turn it down in Windows.")); }
        if (AppState.alert == 3) { return @tr("Still listening to you. Headphones only!"); }
        if (AppState.alert == 4) { return AppState.linux ? @tr("Your mic is muted.") : @tr("Your mic is muted in Windows."); }
        if (AppState.alert == 6) { return @tr("No microphone found. kyrr keeps looking."); }
        if (AppState.alert == 7) { return @tr("Microphone connected: {}", AppState.connected-name); }
        return "";
    }
    text: root.note();
    // The red notes are problems; a microphone coming back is good news.
    color: AppState.alert == 7 ? #3fb950 : #e5484d;
    font-size: 11px;
    min-height: 16px;
    vertical-alignment: center;
    overflow: elide;
    // The mute note stays; the others take turns.
    opacity: (AppState.phrase-visible || AppState.alert == 4 || AppState.alert == 6 || AppState.alert == 7) ? 1 : 0;
    animate opacity { duration: 450ms; easing: ease-in-out; }
}

component HideRow inherits HorizontalLayout {
    spacing: 8px;
    Button {
        text: @tr("Quit");
        horizontal-stretch: 0;
        clicked => { AppState.quit-app(); }
    }
    Hint {
        // Without a tray, the window's X minimizes kyrr where the desktop
        // can (which needs no word); tiling ones cannot, there it quits.
        text: !AppState.linux ? @tr("kyrr keeps running in the tray, bottom right.")
            : AppState.tray ? @tr("kyrr keeps running in the tray.")
            : AppState.can-minimize ? ""
            : @tr("No tray here: closing the window quits kyrr.");
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Where there is neither a tray nor a minimizing desktop (Hyprland
    // without a bar tray), the button would do nothing: it stays away.
    if AppState.tray || AppState.can-minimize: Button {
        text: @tr("Off to the corner");
        horizontal-stretch: 0;
        clicked => { AppState.hide(); }
    }
}

// Settings: everything about how the voice sounds.
component VoiceSettings inherits Card {
    pure function look-hint(i: int) -> string {
        if (i == 1) { return @tr("A bit more belly, less edge. Cosy."); }
        if (i == 2) { return @tr("Takes the boxiness out, speech moves forward."); }
        if (i == 3) { return @tr("More sparkle on top. Rescues dull mics."); }
        if (i == 4) { return @tr("Your own mix. Kept when you switch back and forth."); }
        return @tr("No make-up. Your voice as it is.");
    }
    pure function compressor-hint(i: int) -> string {
        if (i == 1) { return @tr("Smooths a little. You will hardly notice, your listeners will."); }
        if (i == 2) { return @tr("Quiet words come through better. Good for calls."); }
        if (i == 3) { return @tr("Nearly constant volume. For streams and noisy rooms."); }
        return @tr("Loud stays loud, quiet stays quiet. As nature intended.");
    }
    pure function deesser-hint(i: int) -> string {
        if (i == 1) { return @tr("Takes the edge off hissing S sounds."); }
        if (i == 2) { return @tr("Tames S and SH clearly. Good for bright mics."); }
        if (i == 3) { return @tr("Heavy. Can sound lispy close to the mic."); }
        return @tr("S sounds stay as they are.");
    }
    property <bool> shown: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
        && AppState.filter-state != FilterState.unsupported && AppState.voice-enabled;

    Heading { text: @tr("Voice"); }
    if !root.shown: Hint {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire, which is not running.") : @tr("Not on ARM processors yet, sorry."))
            : @tr("Voice is off, so there is nothing to turn. Switch it on in the main view.");
    }
    if root.shown: Caption { text: @tr("Sound"); }
    if root.shown: Segmented {
        options: AppState.advanced || AppState.look-index == 4 ? [@tr("Neutral"), @tr("Warm"), @tr("Clear"), @tr("Bright"), @tr("Custom")]
            : [@tr("Neutral"), @tr("Warm"), @tr("Clear"), @tr("Bright")];
        selected <=> AppState.look-index;
        changed(i) => { AppState.look-changed(i); }
    }
    if root.shown: Hint { text: root.look-hint(AppState.look-index); }
    if root.shown && AppState.advanced && AppState.look-index == 4: VerticalLayout {
        spacing: 2px;
        BandRow {
            label: @tr("Body");
            value <=> AppState.body-db;
            changed(v) => { AppState.band-changed(0, v); }
        }
        BandRow {
            label: @tr("Presence");
            value <=> AppState.presence-db;
            changed(v) => { AppState.band-changed(1, v); }
        }
        BandRow {
            label: @tr("Air");
            value <=> AppState.air-db;
            changed(v) => { AppState.band-changed(2, v); }
        }
    }
    if root.shown && AppState.advanced: Caption { text: @tr("Compressor"); }
    if root.shown && AppState.advanced: Segmented {
        options: [@tr("Off"), @tr("Light"), @tr("Medium"), @tr("Strong")];
        selected <=> AppState.compressor-index;
        changed(i) => { AppState.compressor-changed(i); }
    }
    if root.shown && AppState.advanced: Hint { text: root.compressor-hint(AppState.compressor-index); }
    if root.shown && AppState.advanced: Caption { text: @tr("Soften S sounds"); }
    if root.shown && AppState.advanced: Segmented {
        options: [@tr("Off"), @tr("Light"), @tr("Medium"), @tr("Strong")];
        selected <=> AppState.deesser-index;
        changed(i) => { AppState.deesser-changed(i); }
    }
    if root.shown && AppState.advanced: Hint { text: root.deesser-hint(AppState.deesser-index); }
    if root.shown && AppState.advanced: HorizontalLayout {
        Caption { text: @tr("Cut low rumble"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.low-cut;
            toggled => { AppState.low-cut-toggled(self.checked); }
        }
    }
    if root.shown && AppState.advanced: Hint {
        text: AppState.low-cut ? @tr("Swallows footsteps, desk bumps and wind below {} Hz.", AppState.look-index == 3 ? 100 : 80)
            : @tr("Off. Rumble, wind and desk bumps get through.");
    }
    if root.shown && AppState.advanced: HorizontalLayout {
        Caption { text: @tr("Pop protection"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.pops;
            toggled => { AppState.pops-toggled(self.checked); }
        }
    }
    if root.shown && AppState.advanced: Hint {
        text: AppState.pops ? @tr("Takes the thump out of P and B when you are close to the mic.")
            : @tr("Off. P and B can thump.");
    }
    if root.shown && !AppState.voice-is-default: HorizontalLayout {
        Rectangle { }
        Button { text: @tr("Reset"); clicked => { AppState.voice-reset(); } }
    }
}

// Settings: the automatic volume, a choice of its own: it works with or
// without the voice shaping. The advanced view shows what it does right now.
component LevelSettings inherits Card {
    property <bool> available: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
        && AppState.filter-state != FilterState.unsupported;
    property <int> gain: round(AppState.level-gain);
    RowHead {
        title: @tr("Automatic volume");
        enabled: root.available;
        checked <=> AppState.auto-level;
        toggled(on) => { AppState.auto-level-toggled(on); }
    }
    Hint {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire, which is not running.") : @tr("Not on ARM processors yet, sorry."))
            : !root.available ? @tr("Set up a microphone first.")
            : AppState.auto-level ? @tr("Always the same volume, however your mic is set. If your call app does that too, switch one off.")
            : (AppState.linux ? @tr("Off. Your mic as loud as your system sets it.") : @tr("Off. Your mic as loud as Windows sets it."));
    }
    // What it adds right now: green when it boosts, red when it cuts.
    property <string> signed: root.gain > 0 ? "+" + root.gain : root.gain < 0 ? "−" + (-root.gain) : "0";
    if root.available && AppState.auto-level && AppState.advanced: Caption {
        text: !AppState.mic-active ? @tr("Shows what it evens out while an app uses the mic.")
            : root.gain == 0 ? @tr("Right now unchanged: your mic is just right.")
            : @tr("Right now: {} dB", root.signed);
        color: !AppState.mic-active || root.gain == 0 ? Palette.foreground.with-alpha(0.65)
            : root.gain > 0 ? (Palette.color-scheme == ColorScheme.dark ? #3fb950 : #1a7f37)
            : (Palette.color-scheme == ColorScheme.dark ? #e5484d : #c62a2f);
    }
}

// Settings: the level meter and the before/after test.
component ToolsSettings inherits Card {
    property <bool> attached: AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking;
    property <bool> busy: AppState.probe-state != ProbeState.idle;
    // Level and test come from the filter; listening works without it.
    property <bool> filter: AppState.filter-state != FilterState.unsupported;

    Heading { text: @tr("Check"); }
    if root.filter: Meter {
        before: AppState.level-before;
        after: AppState.level-after;
        opacity: AppState.mic-active ? 1 : 0.4;
    }
    if root.filter: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Rectangle { width: 10px; height: 10px; y: 3px; border-radius: 5px; background: Palette.foreground.with-alpha(0.18); }
        Hint { text: @tr("your mic"); horizontal-stretch: 0; }
        Rectangle { width: 14px; }
        Rectangle { width: 14px; height: 4px; y: 6px; border-radius: 2px; background: Palette.accent-background; }
        Hint { text: @tr("what your apps get"); horizontal-stretch: 0; }
    }
    if root.filter: Hint { text: @tr("Moves while an app uses the mic."); }
    if root.filter: HorizontalLayout {
        spacing: 6px;
        Button {
            text: @tr("Test: before / after");
            enabled: root.attached && !root.busy && !AppState.listening;
            clicked => { AppState.probe-record(); }
        }
        Rectangle { }
        if AppState.has-probe: Button {
            text: @tr("Before");
            enabled: !root.busy;
            clicked => { AppState.probe-play(false); }
        }
        if AppState.has-probe: Button {
            text: @tr("After");
            enabled: !root.busy;
            clicked => { AppState.probe-play(true); }
        }
    }
    if AppState.has-probe: HorizontalLayout {
        Rectangle { }
        Button {
            text: @tr("Delete recording");
            enabled: !root.busy;
            clicked => { AppState.probe-reset(); }
        }
    }
    if root.filter: Hint { text: @tr("Records ten seconds, then compare. Nothing is saved."); }
    HorizontalLayout {
        if !AppState.listening: Button {
            text: @tr("Listen to yourself");
            enabled: !root.busy;
            clicked => { AppState.listen-toggled(); }
        }
        if AppState.listening: AlertButton {
            text: @tr("Stop listening");
            clicked => { AppState.listen-toggled(); }
        }
        Rectangle { }
    }
    Hint { text: @tr("Your mic live in your headphones, the way your apps hear it. On speakers it squeals."); }
    if AppState.probe-error != "": Caption { text: AppState.probe-error; color: #e5484d; }
}

// Settings: the rest.
component GeneralSettings inherits Card {
    Heading { text: @tr("General"); }
    HorizontalLayout {
        spacing: 8px;
        Caption { text: @tr("Language"); vertical-alignment: center; }
        Segmented {
            options: ["Deutsch", "English"];
            selected <=> AppState.language-index;
            changed(i) => { AppState.language-changed(i); }
        }
    }
    Hint { text: @tr("Also the language dictation listens for."); }
    Separator { }
    HorizontalLayout {
        Caption { text: (AppState.linux ? @tr("Start when you sign in") : @tr("Start with Windows")); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.autostart;
            toggled => { AppState.autostart-toggled(self.checked); }
        }
    }
    if AppState.advanced: Separator { }
    if AppState.advanced: HorizontalLayout {
        Caption { text: @tr("Check for updates automatically"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.update-auto;
            toggled => { AppState.update-auto-toggled(self.checked); }
        }
    }
    if AppState.advanced: Hint {
        text: AppState.update-auto ? @tr("kyrr asks GitHub once a day. Nothing about you is sent, installing is always your click.")
            : @tr("kyrr only asks GitHub when you click.");
    }
    if AppState.advanced: HorizontalLayout {
        Rectangle { }
        Button {
            text: @tr("Check for updates");
            enabled: AppState.update-state != UpdateState.checking && AppState.update-state != UpdateState.downloading
                && AppState.update-state != UpdateState.installing;
            clicked => { AppState.check-updates(); }
        }
    }
    if AppState.advanced && (AppState.update-state == UpdateState.checking): Hint { text: @tr("Having a look…"); }
    if AppState.advanced && (AppState.update-state == UpdateState.current): Hint { text: @tr("You have the newest version. Nothing to do."); }
    if AppState.advanced && (AppState.update-state == UpdateState.failed): Hint { text: @tr("Could not check right now. Offline?"); }
    // Text and button separately: wrapped text inside a nested layout
    // under `if` is measured as one line.
    if AppState.advanced && (AppState.update-state == UpdateState.available && AppState.update-installable): Hint {
        text: @tr("Version {} is out. One click and kyrr updates itself, your settings stay.", AppState.update-version);
    }
    if AppState.advanced && (AppState.update-state == UpdateState.available && !AppState.update-installable): Hint {
        text: (AppState.linux ? @tr("Version {} is out. Update kyrr where you installed it from, your settings stay.", AppState.update-version) : @tr("Version {} is out. Download it and run the installer, your settings stay.", AppState.update-version));
    }
    if AppState.advanced && (AppState.update-state == UpdateState.download-failed): Hint {
        text: @tr("The download did not work. Try again, or get it from the download page.");
    }
    if AppState.advanced && (AppState.update-state == UpdateState.available || AppState.update-state == UpdateState.download-failed): HorizontalLayout {
        spacing: 8px;
        Rectangle { }
        Button {
            text: @tr("Download page");
            clicked => { AppState.open-update(); }
        }
        if AppState.update-installable: Button {
            text: @tr("Update now");
            primary: true;
            clicked => { AppState.install-update(); }
        }
    }
    if AppState.advanced && (AppState.update-state == UpdateState.downloading): Hint {
        text: @tr("Downloading the update… {}%", round(AppState.update-progress * 100));
    }
    if AppState.advanced && (AppState.update-state == UpdateState.downloading): ProgressIndicator { progress: AppState.update-progress; height: 6px; }
    if AppState.advanced && (AppState.update-state == UpdateState.installing): Hint {
        text: @tr("Installing. Windows asks for permission once, then kyrr restarts by itself.");
    }
    if AppState.filter-state != FilterState.unsupported: Separator { }
    if AppState.filter-state != FilterState.unsupported: HorizontalLayout {
        spacing: 8px;
        Caption { text: AppState.attached-mic != "" ? AppState.attached-mic : @tr("Microphone"); horizontal-stretch: 1; vertical-alignment: center; }
        Button { text: @tr("Change microphone"); clicked => { AppState.change-microphone(); } }
    }
}

component SetupPage inherits VerticalLayout {
    in property <int> step;
    // Linux without PipeWire: the first step offers to set it up instead.
    property <bool> no-pipewire: AppState.linux && AppState.filter-state == FilterState.unsupported
        && (AppState.pipewire-button || AppState.pipewire-note != "");
    spacing: 12px;
    // Every element carries its own `if`: Slint measures wrapped text
    // wrongly inside a nested layout that is itself conditional.
    if step == 0: Hint { text: @tr("Step 1 of 2"); }
    if step == 0: Heading { text: @tr("Welcome to kyrr"); font-size: 20px; }
    if step == 0: Caption {
        text: root.no-pipewire ? @tr("kyrr removes background noise from your microphone, for every app. For that it needs PipeWire, the sound system of modern Linux desktops, which is missing here.")
            : @tr("kyrr removes background noise from your microphone, for every app. Which microphone do you use?");
    }
    if step == 0 && root.no-pipewire && AppState.pipewire-button: Button {
        text: @tr("Set up PipeWire");
        primary: true;
        clicked => { AppState.install-pipewire(); }
    }
    if step == 0 && root.no-pipewire && AppState.pipewire-note != "": Hint { text: AppState.pipewire-note; }
    if step == 0 && !root.no-pipewire: ComboBox {
        model: AppState.microphones;
        current-index <=> AppState.mic-index;
    }
    if step == 0 && !root.no-pipewire: Caption { text: (AppState.linux ? @tr("kyrr adds a microphone called “kyrr” and makes it the default. Apps set to a particular microphone need to be switched to “kyrr”.") : @tr("Windows will ask for permission. Sound pauses for a moment while kyrr sets up.")); }
    if step == 0 && !root.no-pipewire: Button {
        text: AppState.filter-state == FilterState.setting-up ? @tr("Setting up…") : @tr("Set up microphone");
        primary: true;
        enabled: AppState.filter-state != FilterState.setting-up && AppState.microphones.length > 0;
        clicked => { AppState.attach-microphone(AppState.mic-index); }
    }
    if step == 0 && AppState.filter-state == FilterState.error: Caption { text: AppState.error-text; color: #e5484d; }
    if step == 0: Button {
        text: @tr("Not now, just dictation");
        enabled: AppState.filter-state != FilterState.setting-up;
        clicked => { AppState.skip-setup(); }
    }

    if step == 1: Hint { text: @tr("Step 2 of 2"); }
    if step == 1: Heading { text: @tr("Talk instead of typing"); font-size: 20px; }
    if step == 1: Caption {
        text: AppState.key-note == "" || AppState.guide ? @tr("Hold {} anywhere, speak, release: kyrr types what you said. It runs on your computer, nothing is sent anywhere.", AppState.key-name)
            : @tr("Start dictation with a key, speak, end it: kyrr types what you said. It runs on your computer, nothing is sent anywhere.");
    }
    if step == 1: Caption { text: @tr("Language"); }
    if step == 1: Segmented {
        options: ["Deutsch", "English"];
        selected <=> AppState.language-index;
        changed(i) => { AppState.language-changed(i); }
    }
    if step == 1: DictationCard { in-setup: true; }
    if step == 1 && AppState.key-note != "" && !AppState.guide: Hint { text: AppState.key-note; }
    // The desktop's questions, one at a time, each said before it comes.
    if step == 1 && AppState.guide: Caption {
        text: AppState.key-state == 0 ? @tr("Dictation uses {}. Your desktop has to allow that once: click below, then “Add” in its window.", AppState.key-name)
            : AppState.key-state == 1 ? @tr("Now click “Add” in your desktop's window: the blue button at its top right. {} is already filled in, the pencil is not needed.", AppState.key-name)
            : AppState.key-state == 3 ? @tr("{} is not set up yet: the window was closed without “Add”. Try again?", AppState.key-name)
            : AppState.key-tried ? @tr("✓ {} works.", AppState.key-name)
            : @tr("✓ {} is set up. Try it: press {} once.", AppState.key-name, AppState.key-name);
    }
    if step == 1 && AppState.guide && (AppState.key-state == 0 || AppState.key-state == 3): Button {
        text: AppState.key-state == 0 ? @tr("Set up {}", AppState.key-name) : @tr("Try again");
        primary: true;
        clicked => { AppState.setup-key(); }
    }
    if step == 1 && AppState.guide && AppState.key-state == 2: Caption {
        text: AppState.typing-state == 0 ? @tr("Last step: kyrr types your words into other apps. Your desktop asks once (“Remote Desktop”): switch on “Allow Remote Interaction”, then click “Share”.")
            : AppState.typing-state == 1 ? @tr("In your desktop's window: switch on “Allow Remote Interaction” (its only switch), then click “Share”, the blue button at the top right.")
            : AppState.typing-state == 3 ? @tr("Not allowed, so kyrr cannot type for you. Try again?")
            : @tr("✓ kyrr may type.");
    }
    if step == 1 && AppState.guide && AppState.key-state == 2 && (AppState.typing-state == 0 || AppState.typing-state == 3): Button {
        text: AppState.typing-state == 0 ? @tr("Allow typing") : @tr("Try again");
        primary: true;
        clicked => { AppState.allow-typing(); }
    }
    if step == 1: Hint { text: (AppState.linux ? @tr("kyrr starts when you sign in and lives in the tray, if your desktop has one. Both can be changed in the settings.") : @tr("kyrr starts with Windows and lives in the tray, bottom right (maybe behind the little arrow). Both can be changed in the settings.")); }
    if step == 1: Button {
        text: @tr("Done");
        primary: AppState.dictation-state != DictationState.no-model
            && (!AppState.guide || (AppState.key-state == 2 && AppState.typing-state == 2));
        clicked => { AppState.finish-setup(); }
    }
}

// What is new in the version on offer: a small window of its own with the
// summary the release brings, in plain words.
export component NewsWindow inherits Window {
    in property <string> version;
    in property <string> news;
    // 0: the version on offer, 1: the one that just got installed, 2: all of them.
    in property <int> mode;
    callback close();
    title: @tr("What's new");
    icon: @image-url("icons/kyrr-256.png");
    preferred-width: 380px;
    min-width: 320px;
    preferred-height: 320px;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Heading {
            text: root.mode == 2 ? @tr("What's new in kyrr")
                : root.mode == 1 ? @tr("What kyrr {} brings", root.version)
                : @tr("kyrr {} is out", root.version);
            font-size: 18px;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                width: parent.visible-width;
                Text {
                    text: root.news;
                    wrap: word-wrap;
                    font-size: 13px;
                }
            }
        }
        HorizontalLayout {
            Rectangle { }
            Button {
                text: @tr("Close");
                primary: true;
                horizontal-stretch: 0;
                clicked => { root.close(); }
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <bool> setup-mode;
    in property <int> setup-step;
    // The height the content wants; the app caps the window and scrolls.
    out property <length> content-height: layout.preferred-height;
    callback content-height-changed();
    // The window came up (from the tray, at start); the app starts the meter.
    callback shown();
    changed content-height => { root.content-height-changed(); }
    // One column, 380 px; the settings in two side by side.
    out property <length> page-width: settings-page ? 760px : 380px;
    title: "kyrr";
    icon: @image-url("icons/kyrr-256.png");
    preferred-width: page-width;
    // A fixed width also keeps the window floating on tiling compositors
    // (Hyprland treats it like a dialog), which suits a small tool.
    min-width: page-width;
    max-width: page-width;
    // The main page has one height, fixed: its content's. The settings page
    // can be dragged taller or shorter and scrolls.
    // Other pages: the height the app picked (Linux only). Floating Wayland
    // compositors honour a minimum size, not a resize.
    in property <length> fit-height: 0px;
    // The same height as a maximum for a moment, so a compositor that keeps
    // its own idea of the size (Hyprland) lets the window shrink too.
    in property <bool> fit-hold;
    min-height: main-page ? layout.preferred-height : root.fit-height;
    max-height: main-page ? layout.preferred-height : root.fit-hold ? root.fit-height : 16384px;

    // A new page starts at the top, not where the last one was scrolled to.
    public function reset-scroll() {
        scroll.content-y = 0;
    }

    // Dark, whatever Windows says. Only for the README screenshots: the
    // headless preview has no system theme to follow.
    public function use-dark-scheme() {
        Palette.color-scheme = ColorScheme.dark;
    }

    property <bool> main-page: !setup-mode && AppState.page == 0;
    property <bool> settings-page: !setup-mode && AppState.page == 1;

    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: layout.preferred-height;
        layout := VerticalLayout {
            width: scroll.visible-width;
            padding: 18px;
            spacing: 12px;
            // Direct children, not a nested layout in an `if`: Slint then
            // measures wrapped text at its real width.
            if setup-mode: SetupPage { step: root.setup-step; }

            // Main view: the status line and the three switches.
            if main-page: HorizontalLayout {
                spacing: 10px;
                Image { source: @image-url("icons/kyrr-256.png"); width: 28px; height: 28px; }
                Heading { text: "kyrr"; font-size: 20px; vertical-alignment: center; }
                Rectangle { }
                Button {
                    text: @tr("Settings");
                    horizontal-stretch: 0;
                    clicked => {
                        AppState.page = 1;
                        AppState.page-changed();
                    }
                }
            }
            if main-page: StatusLine { }
            if main-page: NoiseCard { }
            if main-page: VoiceCard { }
            if main-page: DictationCard { }
            if main-page && !AppState.update-dismissed && (AppState.update-state == UpdateState.available
                || AppState.update-state == UpdateState.downloading || AppState.update-state == UpdateState.installing
                || AppState.update-state == UpdateState.download-failed): UpdateBanner { }
            if main-page: HorizontalLayout {
                spacing: 8px;
                AlertLine { }
                if AppState.alert == 4: Text {
                    text: @tr("Switch it on");
                    color: #e5484d;
                    font-size: 11px;
                    font-weight: 700;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                    TouchArea { clicked => { AppState.unmute(); } mouse-cursor: pointer; }
                }
            }
            if main-page: HideRow { }

            // Settings page: the deeper options.
            if settings-page: HorizontalLayout {
                spacing: 10px;
                Button {
                    text: @tr("← Back");
                    horizontal-stretch: 0;
                    clicked => {
                        AppState.page = 0;
                        AppState.page-changed();
                    }
                }
                Heading { text: @tr("Settings"); font-size: 20px; vertical-alignment: center; }
                Rectangle { }
                // The basics by default; the rest for those who want it.
                VerticalLayout {
                    alignment: center;
                    Segmented {
                        width: 240px;
                        options: [@tr("Simple"), @tr("Advanced")];
                        selected: AppState.advanced ? 1 : 0;
                        changed(i) => {
                            AppState.advanced = i == 1;
                            AppState.advanced-toggled(i == 1);
                        }
                    }
                }
            }
            // Two columns of about equal length. Fixed column widths, so
            // wrapped text is measured at its real width.
            if settings-page: HorizontalLayout {
                spacing: 36px;
                VerticalLayout {
                    width: 344px;
                    spacing: 12px;
                    alignment: start;
                    NoiseSettings { }
                    VoiceSettings { }
                    // Simple: here, with the voice. Advanced: the voice card
                    // is tall, so it moves over to the shorter right column.
                    if !AppState.advanced: LevelSettings { }
                    GeneralSettings { }
                }
                VerticalLayout {
                    width: 344px;
                    spacing: 12px;
                    alignment: start;
                    DictationSettings { }
                    ToolsSettings { }
                    if AppState.advanced: LevelSettings { }
                    AboutSettings { }
                }
            }
            if settings-page: Caption {
                // English in every language, on purpose.
                text: "Proudly presented by heast13 and Claude “Silent but deadly” Opus. No microphones were harmed.";
                horizontal-alignment: center;
                font-size: 11px;
                font-italic: true;
            }
            if settings-page: Caption {
                text: "kyrr " + AppState.version;
                horizontal-alignment: center;
                font-size: 11px;
            }
        }
    }
}
