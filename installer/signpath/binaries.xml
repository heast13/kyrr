<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "binaries": kyrr.exe and kyrr_apo.dll,
     uploaded by the release workflow as one zip. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="kyrr.exe" product-name="kyrr" product-version="${version}">
      <authenticode-sign />
    </pe-file>
    <pe-file path="kyrr_apo.dll" product-name="kyrr" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
