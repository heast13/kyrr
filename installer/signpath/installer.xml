<?xml version="1.0" encoding="utf-8"?>
<!-- SignPath artifact configuration "installer": the Inno Setup installer,
     built from the signed binaries, uploaded as a zip. -->
<artifact-configuration xmlns="http://signpath.io/artifact-configuration/v1">
  <parameters>
    <parameter name="version" required="true" />
  </parameters>
  <zip-file>
    <pe-file path="kyrr-setup-${version}.exe" product-name="kyrr" product-version="${version}">
      <authenticode-sign />
    </pe-file>
  </zip-file>
</artifact-configuration>
