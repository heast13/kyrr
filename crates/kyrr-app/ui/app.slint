// kyrr's user interface: the tray icon and one small window that shows the
// first-run setup or the main panel. All texts are English source strings
// translated through the bundled translations in ui/lang.

import { Button as SystemButton, ComboBox, Switch as SystemSwitch, Slider, ProgressIndicator as SystemProgress, ScrollView, LineEdit, Palette } from "std-widgets.slint";

// detached: Windows (an update, a driver) took kyrr off the microphone.
// unsupported: this PC cannot run the filter (Windows on ARM, Linux without
// PipeWire).
export enum FilterState { checking, running, off, passthrough, not-attached, not-installed, setting-up, error, detached, unsupported }
export enum DictationState { off, no-model, downloading, loading, ready, recording, transcribing, error }
export enum ProbeState { idle, recording, before, after }
// downloading and installing: "Update now" at work; download-failed
// offers it again, and the download page.
export enum UpdateState { idle, checking, current, available, failed, downloading, installing, download-failed }
// What the main page says about a computer that could not keep up with the noise model.
export enum OverloadNote { none, switched, pauses }

// One voice memo in the list. text-state: 0 none, 1 waiting for its turn,
// 2 being written, 3 written, 4 failed.
export struct MemoItem {
    title: string,
    // Date, time and length, one line.
    when: string,
    // Its title is still being found.
    pending: bool,
    text-state: int,
    text-progress: float,
    // "about 2 min. left", or "".
    text-left: string,
}

// How kyrr looks: like the system, or on Omarchy like Omarchy (its theme's
// colours, square corners, its monospace font). The app sets the theme and
// follows a change of it.
export global Skin {
    in property <bool> omarchy;
    in property <color> theme-background;
    in property <color> theme-foreground;
    in property <color> theme-accent;
    in property <color> theme-red;
    in property <color> theme-yellow;
    in property <color> theme-green;
    in property <string> theme-font;
    property <bool> dark: Palette.color-scheme == ColorScheme.dark;
    out property <brush> background: root.omarchy ? root.theme-background : Palette.background;
    out property <brush> foreground: root.omarchy ? root.theme-foreground : Palette.foreground;
    // Omarchy's cards and controls: a little of the text colour over the background.
    out property <brush> alternate-background: root.omarchy ? root.theme-foreground.mix(root.theme-background, 0.04) : Palette.alternate-background;
    out property <brush> control-background: root.omarchy ? root.theme-foreground.mix(root.theme-background, 0.08) : Palette.control-background;
    out property <brush> control-foreground: root.omarchy ? root.theme-foreground : Palette.control-foreground;
    out property <brush> accent-background: root.omarchy ? root.theme-accent : Palette.accent-background;
    out property <brush> accent-foreground: root.omarchy ? root.theme-background : Palette.accent-foreground;
    out property <brush> border: root.omarchy ? root.theme-foreground.with-alpha(0.4) : Palette.border;
    // Cards get a frame on Omarchy, as its menus and panels have.
    out property <length> card-frame: root.omarchy ? 1px : 0px;
    // Notes: darker on a light system, so small text keeps its contrast.
    out property <color> bad: root.omarchy ? root.theme-red : root.dark ? #ff6369 : #c62a2f;
    out property <color> good: root.omarchy ? root.theme-green : root.dark ? #3fb950 : #1a7f37;
    out property <color> picked: root.omarchy ? root.theme-accent : #2ea043;
    out property <color> warning: root.omarchy ? root.theme-yellow : #d29922;
    out property <color> refusal: root.omarchy ? root.theme-red : #e0604f;
    out property <color> danger: root.omarchy ? root.theme-red : #e5484d;
    out property <color> danger-hover: root.omarchy ? root.theme-red.darker(0.1) : #cf3338;
    out property <color> danger-pressed: root.omarchy ? root.theme-red.darker(0.25) : #b4282c;
    // The logo's colour, for the small wave by the status line.
    out property <color> logo: root.omarchy ? root.theme-accent : root.dark ? #5eead4 : #14b8a6;
    // Empty: the system's font.
    out property <string> font: root.omarchy ? root.theme-font : "";
    public pure function round(radius: length) -> length {
        return root.omarchy ? 0px : radius;
    }
}

// The system's controls, or on Omarchy square ones in its theme's colours.
component SquareButton inherits Rectangle {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    preferred-width: label.preferred-width + 24px;
    min-width: label.min-width + 16px;
    min-height: 32px;
    border-width: 1px;
    border-color: focus.has-focus ? Skin.theme-accent
        : Skin.theme-foreground.with-alpha(root.primary ? 0 : 0.4);
    background: root.primary ? (touch.has-hover && root.enabled ? Skin.theme-accent.brighter(0.1) : Skin.theme-accent)
        : touch.pressed ? Skin.theme-foreground.with-alpha(0.16)
        : touch.has-hover && root.enabled ? Skin.theme-foreground.with-alpha(0.08) : transparent;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.clicked(); }
    label := Text {
        x: 12px;
        width: parent.width - 24px;
        height: parent.height;
        text: root.text;
        color: root.primary ? Skin.theme-background : Skin.theme-foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
        overflow: elide;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == "\n") {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component Button inherits HorizontalLayout {
    in property <string> text;
    in property <bool> primary;
    in property <bool> enabled: true;
    callback clicked;
    // As the system's button: as wide as its text unless told otherwise.
    horizontal-stretch: 0;
    if !Skin.omarchy: SystemButton {
        text: root.text;
        primary: root.primary;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
    if Skin.omarchy: SquareButton {
        text: root.text;
        primary: root.primary;
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }
}

component SquareSwitch inherits Rectangle {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    callback toggled;
    function flip() {
        root.checked = !root.checked;
        root.toggled();
    }
    min-width: 36px;
    max-width: 36px;
    min-height: 20px;
    opacity: root.enabled ? 1 : 0.45;
    accessible-role: checkbox;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-enabled: root.enabled;
    accessible-action-default => { root.flip(); }
    Rectangle {
        y: (parent.height - self.height) / 2;
        height: 20px;
        background: root.checked ? Skin.theme-accent : transparent;
        border-width: 1px;
        border-color: root.checked ? Skin.theme-accent : Skin.theme-foreground.with-alpha(focus.has-focus ? 0.9 : 0.4);
        Rectangle {
            x: root.checked ? parent.width - 16px : 4px;
            y: 4px;
            width: 12px;
            height: 12px;
            background: root.checked ? Skin.theme-background : Skin.theme-foreground.with-alpha(0.7);
            animate x { duration: 120ms; easing: ease-out; }
        }
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.flip(); }
    }
    focus := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " ") {
                root.flip();
                return accept;
            }
            return reject;
        }
    }
}

component Switch inherits HorizontalLayout {
    in-out property <bool> checked;
    in property <bool> enabled: true;
    // For screen readers.
    in property <string> label;
    callback toggled;
    horizontal-stretch: 0;
    if !Skin.omarchy: SystemSwitch {
        checked <=> root.checked;
        enabled: root.enabled;
        accessible-label: root.label;
        toggled => { root.toggled(); }
    }
    if Skin.omarchy: SquareSwitch {
        checked <=> root.checked;
        enabled: root.enabled;
        accessible-label: root.label;
        toggled => { root.toggled(); }
    }
}

// Omarchy's progress bar: the accent over a dim track, as in its on-screen display.
component ProgressIndicator inherits Rectangle {
    in property <float> progress;
    if !Skin.omarchy: SystemProgress {
        width: parent.width;
        height: parent.height;
        progress: root.progress;
    }
    if Skin.omarchy: Rectangle {
        background: Skin.theme-foreground.with-alpha(0.25);
        Rectangle {
            x: 0;
            width: parent.width * clamp(root.progress, 0, 1);
            background: Skin.theme-accent;
        }
    }
}

export global AppState {
    pure function pick(list: [string]) -> string {
        return list[AppState.phrase.mod(list.length)];
    }
    property <float> percent: round(AppState.download-progress * 100);

    // The line under kyrr's name: what kyrr does, in word creations that
    // change with `phrase`. kyrr's widget in Omarchy's bar shows it too.
    public pure function status-line() -> string {
        if (AppState.filter-state == FilterState.setting-up) { return @tr("Setting things up… sound takes a short break."); }
        if (AppState.mic-active && AppState.mic-silent) { return @tr("Your mic delivers pure silence. Muted?"); }
        if (AppState.probe-state == ProbeState.recording) {
            return pick([
                @tr("Ten seconds of fame."),
                @tr("Noise for science."),
                @tr("Open-mic night, short edition."),
                @tr("Shopping-list reading hour."),
                @tr("Say anything."),
                @tr("Tongue-twister warm-up."),
                @tr("Voicemail audition."),
                @tr("Phone-book recital."),
                @tr("Interview with yourself."),
                @tr("Nobody's judging. Much."),
                @tr("Humming allowed."),
                @tr("Podcast career, take one."),
                @tr("Cough on cue."),
                @tr("Talking to the void."),
                @tr("Improvised weather report."),
                @tr("Karaoke, no music."),
                @tr("Speech of your life."),
                @tr("Reading the room aloud."),
                @tr("Toast rehearsal."),
                @tr("Self-introduction, awkward edition."),
            ]);
        }
        if (AppState.probe-state == ProbeState.before) { return @tr("Before: this is you without kyrr."); }
        if (AppState.probe-state == ProbeState.after) { return @tr("After: same take, with kyrr."); }
        if (AppState.dictation-state == DictationState.recording) {
            return pick([
                @tr("All ears."),
                @tr("Mumbling permitted."),
                @tr("Listening intently."),
                @tr("Spill the words."),
                @tr("Take your time."),
                @tr("Rambling welcome."),
                @tr("Tape rolling."),
                @tr("Ears pricked."),
                @tr("Stage is yours."),
                @tr("Typing is overrated."),
                @tr("Mouth-to-text resuscitation."),
                @tr("Thinking out loud, recorded."),
                @tr("Eavesdropping, officially."),
                @tr("Ums included."),
                @tr("Throat clearing accepted."),
                @tr("Fingers on holiday."),
                @tr("Blab away."),
                @tr("Notepad with ears."),
                @tr("Words wanted."),
                @tr("Sentence harvest."),
            ]);
        }
        if (AppState.memo-recording) {
            return pick([
                @tr("Tape is rolling."),
                @tr("Recording for posterity."),
                @tr("Memory backup in progress."),
                @tr("Said and saved."),
                @tr("Voice note, freshly pressed."),
                @tr("Bright ideas into the archive."),
                @tr("Thoughts to go."),
                @tr("Talk now, listen later."),
                @tr("Off the record? Nope."),
                @tr("Your private radio show."),
                @tr("Every word into the drawer."),
                @tr("The archive is listening."),
                @tr("Sticky note with a voice."),
                @tr("Memoirs, chapter one."),
                @tr("Voice into the vault."),
                @tr("Forgetting is cancelled."),
                @tr("Dictaphone, only prettier."),
                @tr("Thinking aloud, saved."),
                @tr("Minutes for one."),
                @tr("Ideas in the can."),
            ]);
        }
        if (AppState.dictation-state == DictationState.transcribing) {
            return pick([
                @tr("Mumble translation."),
                @tr("Speed typing."),
                @tr("Word sorting."),
                @tr("Decoding the ums."),
                @tr("Syllable shuffling."),
                @tr("Air into letters."),
                @tr("Comma distribution."),
                @tr("Sentence construction site."),
                @tr("Grammar ironing."),
                @tr("Ghostwriting."),
                @tr("Ramble polishing."),
                @tr("Sense-making."),
                @tr("Letter assembly line."),
                @tr("Typo hunt."),
                @tr("Punctuation roulette."),
                @tr("Sound in, text out."),
                @tr("Hold on, typing."),
                @tr("Word wrangling."),
                @tr("Spelling bee."),
                @tr("Syntax tinkering."),
            ]);
        }
        if (AppState.dictation-state == DictationState.downloading) {
            return pick([
                @tr("{}% · Patience test.", percent),
                @tr("{}% · Coffee-break length.", percent),
                @tr("{}% · Progress-bar hypnosis.", percent),
                @tr("{}% · Chunky delivery.", percent),
                @tr("{}% · Bits on the way.", percent),
                @tr("{}% · Watching paint dry.", percent),
                @tr("{}% · Brain by post.", percent),
                @tr("{}% · Slow but trying.", percent),
                @tr("{}% · Bytes marching in.", percent),
                @tr("{}% · Kettle time.", percent),
                @tr("{}% · Internet doing its best.", percent),
                @tr("{}% · Stretch your legs.", percent),
                @tr("{}% · Heavy freight.", percent),
                @tr("{}% · Don't stare at it.", percent),
                @tr("{}% · Pigeon post, upgraded.", percent),
                @tr("{}% · Brain filling up.", percent),
                @tr("{}% · Worth the wait. Probably.", percent),
                @tr("{}% · Byte by byte.", percent),
                @tr("{}% · Slow-motion magic.", percent),
                @tr("{}% · Staring contest with a bar.", percent),
            ]);
        }
        if (AppState.model-switching) {
            return pick([
                @tr("Brain transplant."),
                @tr("Neuron relocation."),
                @tr("Model swap break."),
                @tr("Head swap."),
                @tr("Mid-flight engine swap."),
                @tr("Brain surgery, no anaesthetic."),
                @tr("Grey-matter reboot."),
                @tr("New knowledge loading."),
                @tr("Thinking-cap fitting."),
                @tr("Change of mind."),
                @tr("Blackboard wiping."),
                @tr("Synapse shuffle."),
                @tr("Light brainwashing."),
                @tr("Wits swap."),
                @tr("Out with the old IQ."),
                @tr("Brief stupidity."),
                @tr("Musical neurons."),
                @tr("Mind reshuffle."),
                @tr("Upgrade pending."),
                @tr("Opening the skull gently."),
            ]);
        }
        if (AppState.filter-state == FilterState.not-installed) { return @tr("The kyrr filter is missing. Reinstall, please."); }
        if (AppState.filter-state == FilterState.detached) { return @tr("Windows took kyrr off the mic. Repair below."); }
        if (AppState.filter-state == FilterState.not-attached) { return @tr("Pick a microphone and off we go."); }
        if (AppState.filter-state == FilterState.error) { return @tr("Oops, something went wrong. Details below."); }
        if (AppState.filter-state == FilterState.passthrough) { return @tr("Oops, the filter is stuck. Your mic passes through as it is."); }
        if (!AppState.filter-enabled && !AppState.voice-enabled && AppState.filter-state != FilterState.unsupported) {
            return pick([
                @tr("Day off. Everything is off."),
                @tr("Hammock mode."),
                @tr("Nothing to do. Wonderful."),
                @tr("Lights out, kyrr snoozes."),
                @tr("Out of office."),
                @tr("Vacation, do not disturb."),
                @tr("Feet up."),
                @tr("Doing absolutely nothing."),
                @tr("Sabbatical in progress."),
                @tr("Off, but smiling."),
                @tr("All quiet on the kyrr front."),
                @tr("Sleeping in."),
                @tr("Pyjama day."),
                @tr("Couch time."),
                @tr("Taking five. Or fifty."),
                @tr("Mic left alone."),
                @tr("Binge break."),
                @tr("Off the clock."),
                @tr("Zero-effort mode."),
                @tr("Recharging by doing nothing."),
            ]);
        }
        if (AppState.mic-active) {
            if (!AppState.filter-enabled) {
                return pick([
                    @tr("Noise allowed, voice polished."),
                    @tr("Voice makeover only."),
                    @tr("Let the dog bark."),
                    @tr("Vacuum may sing."),
                    @tr("Background chaos, untouched."),
                    @tr("Voice shines, room doesn't."),
                    @tr("Noise gets a free pass."),
                    @tr("Neighbour's drill included."),
                    @tr("Keyboard clatter stays."),
                    @tr("Voice on the red carpet."),
                    @tr("Hair and make-up for voices."),
                    @tr("Studio voice, garage room."),
                    @tr("Noise in the front row."),
                    @tr("Voice spa, noise welcome."),
                    @tr("Background keeps its charm."),
                    @tr("Voice upgrade, noise policy: none."),
                    @tr("Noise on the guest list."),
                    @tr("Chaos tolerance, voice care."),
                    @tr("Coughs stay in."),
                    @tr("Squeaky chair, shiny voice."),
                ]);
            }
            return pick([
                @tr("Slurpless."),
                @tr("Barkblocked."),
                @tr("Vacuumexiled."),
                @tr("Drillnope."),
                @tr("Chewproof."),
                @tr("Burpinsured."),
                @tr("Fanmuzzled."),
                @tr("Keyclackfree."),
                @tr("Coworkerpuffstop."),
                @tr("Snoreproof."),
                @tr("Flushfree."),
                @tr("Doorbelldeaf."),
                @tr("Sneezeswallowed."),
                @tr("Stomachgrowlmuted."),
                @tr("Tootproof."),
                @tr("Creakcancelled."),
                @tr("Dishclatterdeleted."),
                @tr("Throatclearbanned."),
                @tr("Hornhushed."),
                @tr("Penclickproof."),
            ]);
        }
        return pick([
            @tr("On-call napping."),
            @tr("Mic waiting room."),
            @tr("Thumb-twiddling mode."),
            @tr("Idle serenity."),
            @tr("Alert nap."),
            @tr("Stockpiling silence."),
            @tr("Waiting for noise."),
            @tr("Ears on standby."),
            @tr("Bored but ready."),
            @tr("Sheep counting."),
            @tr("Nothing on the line."),
            @tr("Gathering dust."),
            @tr("Silence tasting."),
            @tr("Tumbleweed passing."),
            @tr("Polite lurking."),
            @tr("Humming along quietly."),
            @tr("Quiet job, steady pay."),
            @tr("Standing by, sort of."),
            @tr("Crickets in the room."),
            @tr("Quiet before the noise."),
        ]);
    }

    // The small note at the bottom of the main page (and in the widget).
    public pure function alert-note() -> string {
        if (AppState.alert == 1) { return (AppState.linux ? @tr("Mic very quiet. Turn it up in your sound settings.") : @tr("Mic very quiet. Turn it up in Windows.")); }
        if (AppState.alert == 2) { return (AppState.linux ? @tr("Mic too loud. Turn it down in your sound settings.") : @tr("Mic too loud. Turn it down in Windows.")); }
        if (AppState.alert == 3) { return @tr("Still listening to you. Headphones only!"); }
        if (AppState.alert == 4) { return AppState.linux ? @tr("Your mic is muted.") : @tr("Your mic is muted in Windows."); }
        if (AppState.alert == 6) { return @tr("No microphone found. kyrr keeps looking."); }
        if (AppState.alert == 7) { return @tr("Microphone connected: {}", AppState.connected-name); }
        if (AppState.alert == 8) { return @tr("Sounds like a gym. Move a bit closer?"); }
        return "";
    }

    // Noise removal
    in-out property <bool> filter-enabled: true;
    in-out property <int> strength-index: 1; // 0 gentle, 1 medium, 2 strong
    in property <bool> model-switching;
    // The filter fell back to ONNX Runtime: the CPU lacks AVX2, Lean suits it.
    in property <bool> old-cpu;
    // The computer could not keep up with the noise model (see OverloadNote).
    in-out property <OverloadNote> overload-note;
    // Switch to Lean by itself then.
    in-out property <bool> auto-lean: true;
    // Lean and best quality set the noise model and the words while you
    // talk at once: 0 lean, 1 best quality, 2 a mix of the two.
    in-out property <int> effort-index: 1;
    // Linux: the filter is kyrr's own microphone, there is no installer, and
    // the desktop may have no tray.
    in property <bool> linux;
    in property <bool> tray: true;
    // kyrr's widget sits in Omarchy's bar: its menu opens kyrr, turning the
    // plugin off quits it.
    in property <bool> widget;
    // The widget's menu opened (and says so every few seconds while open)
    // or closed: the status line and the notes run for it.
    callback widget-open(bool);
    // A line from the widget's menu, which is all of kyrr on Omarchy: a
    // setting to change or a step to take ("set voice.tone warm").
    callback omarchy-command(string);
    // Without a tray, closing minimizes where the desktop can (not tiling ones).
    in property <bool> can-minimize: true;
    in property <FilterState> filter-state: FilterState.checking;
    in property <string> filter-detail; // technical, not translated
    in property <[string]> microphones;
    in-out property <int> mic-index;
    in property <string> attached-mic;
    // The filtered microphone is unplugged; this one could take over ("" if none).
    in property <string> move-to;
    in property <bool> move-unplugged;

    // The window is up (not hidden in the tray): what only it shows stops
    // moving while it is away.
    in property <bool> window-shown;
    // Live: level and the before/after probe
    in property <bool> mic-active;
    // The microphone is in use but delivers nothing at all: muted, most likely.
    in property <bool> mic-silent;
    // Windows has the microphone muted.
    in-out property <bool> mic-muted;
    // A microphone that just showed up.
    in property <string> connected-name;
    in property <float> level-before; // 0..1
    in property <float> level-after;
    in property <ProbeState> probe-state: ProbeState.idle;
    in property <bool> has-probe;
    in property <string> probe-error;
    // The mic plays live on the headphones.
    in property <bool> listening;
    // The red note at the bottom of the main page, one at a time:
    // 0 none, 1 mic too quiet, 2 mic too loud, 3 still listening.
    in property <int> alert;

    // Voice: sound, S sounds and volume, shaped in the audio filter
    in-out property <bool> voice-enabled: true;
    in-out property <int> look-index;    // neutral, warm, clear, bright, custom
    in-out property <float> body-db;     // the custom sound, -6..6 dB
    in-out property <float> presence-db;
    in-out property <float> air-db;
    in-out property <bool> low-cut: true;
    in-out property <bool> pops;
    in-out property <bool> distance;
    in-out property <bool> auto-level;
    in property <float> level-gain; // what it adds right now, dB
    // The settings page shows everything, not just the basics.
    in-out property <int> deesser-index;       // off, light, medium, strong
    in-out property <int> compressor-index: 2; // off, light, medium, strong
    in property <bool> voice-is-default: true;

    // Dictation
    in-out property <bool> dictation-enabled: true;
    in-out property <int> language-index; // 0 German, 1 English, 2 multilingual
    in property <DictationState> dictation-state: DictationState.off;
    in property <float> download-progress;
    in property <string> download-size;
    in property <string> last-text;
    // What dictation has to say (an error, a hint); "" for nothing.
    in property <string> dictation-message;
    in-out property <bool> key-toggle;  // tap to start and stop instead of holding
    in-out property <bool> live-words;  // the wave shows the words while you talk
    in property <string> key-name: "F9";
    // Which key field waits for a key: 0 none, 1 dictation, 2 voice memos.
    in property <int> key-capture;
    // The key is not the standard one (F9, F8).
    in property <bool> key-custom;
    in property <bool> memo-key-custom;
    // Why the key just pressed was not taken, and a word of warning about one
    // that was; "" for nothing.
    in property <string> key-refusal;
    in property <string> key-warning;
    // A key field starts (1, 2) or stops (0) waiting; the standard key back.
    callback capture-key(int);
    callback key-reset(int);
    // What the user has to do so the key reaches kyrr (Linux); "" for nothing.
    in property <string> key-note;
    // The desktop owns the key (GNOME, KDE): kyrr's choice of key does nothing.
    in property <bool> key-fixed;
    // The desktop could own the key but has not bound it (dialog cancelled).
    in property <bool> key-unbound;
    // A button for the key in the settings ("Set up key", "Change key"); "" for none.
    in property <string> key-button;
    callback key-button-clicked();
    // The setup walks through the desktop's two questions (GNOME, KDE): the
    // key and the permission to type.
    in property <bool> guide;
    // 0 not asked, 1 the desktop is asking, 2 set up, 3 cancelled.
    in property <int> key-state;
    // The key was pressed since it was set up.
    in property <bool> key-tried;
    // 0 not asked, 1 the desktop is asking, 2 allowed, 3 not allowed.
    in property <int> typing-state;
    callback setup-key();
    callback allow-typing();
    // "Check for updates", on request only.
    in property <UpdateState> update-state;
    in property <string> update-version;
    // The new version comes with a short summary of what changed.
    in property <bool> update-has-news;
    // The release's installer; "" when it has none (then only the page).
    in property <bool> update-installable;
    in property <float> update-progress; // 0..1
    // The daily check is on; the user closed the note for this version.
    in-out property <bool> update-auto: true;
    in property <bool> update-dismissed;

    in-out property <bool> autostart;
    // PipeWire is missing (Linux): a button that installs it, and what to
    // say about it ("" for nothing).
    in property <bool> pipewire-button;
    in property <string> pipewire-note;
    callback install-pipewire();
    // How installing it went, a PipewireStep from Rust.
    callback pipewire-step(int);
    in property <string> error-text;
    in property <string> version;

    // 0 is the main view, 1 the setup, then the settings of each
    // card: 2 noise, 3 voice, 4 dictation, 5 voice memos; 6 the voice memos
    // themselves; 7 the user's own models.
    in-out property <int> page;
    // Counts up every few seconds; the status line picks its next phrase
    // from it, so one state does not repeat the same sentence.
    in property <int> phrase;
    // False for a moment before the next phrase, so it fades out and in.
    in property <bool> phrase-visible: true;

    callback filter-toggled(bool);
    callback strength-changed(int);
    callback probe-record();
    callback probe-play(bool); // false before, true after
    callback probe-reset();
    callback listen-toggled();
    callback voice-toggled(bool);
    callback look-changed(int);
    callback band-changed(int, float); // 0 body, 1 presence, 2 air
    callback low-cut-toggled(bool);
    callback pops-toggled(bool);
    callback distance-toggled(bool);
    callback auto-level-toggled(bool);
    callback deesser-changed(int);
    callback compressor-changed(int);
    callback voice-reset();
    callback attach-microphone(int);
    callback dictation-toggled(bool);
    callback language-changed(int);
    callback download-model();
    callback cancel-download();
    callback finish-setup();
    callback change-microphone();
    callback autostart-toggled(bool);
    // Puts the window away, like its close button; kyrr keeps running in the tray.
    callback hide();
    // Ends kyrr for good, like the tray menu's "Quit".
    callback quit-app();
    // Switches Windows' mute off the microphone.
    callback unmute();
    callback page-changed();
    // A card's gear: its own settings page.
    public function open-page(p: int) {
        root.page = p;
        root.page-changed();
    }
    callback dictation-retry();
    callback repair();
    callback move-to-default();
    callback key-toggle-changed(bool);
    callback live-words-toggled(bool);
    callback auto-lean-toggled(bool);
    callback effort-changed(int);
    callback open-licenses();
    callback check-updates();
    callback open-update();
    callback send-feedback();
    callback show-news();
    // What the running version brought (from the NEWS built into the app).
    callback show-current-news();
    callback install-update();
    callback update-auto-toggled(bool);
    callback dismiss-update();
    callback skip-setup();
    callback next-setup();

    // Voice memos
    in-out property <bool> memos-enabled: true;
    in property <string> memo-key-name: "F8"; // "" while no key is taken
    // The memo key whether it is taken or not, for the settings.
    in property <string> memo-key-label: "F8";
    // Another shortcut of the user's has the memo key; "" for none.
    in property <string> memo-key-note;
    in property <bool> memo-toggle: false;     // tap to start and stop instead of holding
    // The key's release is reported (not on GNOME 46 and 47, niri).
    in property <bool> memo-can-hold: true;
    in property <bool> memo-recording;
    in property <string> memo-elapsed;
    in property <[MemoItem]> memo-items;
    // All memos in the folder, whatever the search shows.
    in property <int> memo-count;
    in-out property <string> memo-query;
    in property <int> memo-playing: -1;
    in property <float> memo-play-fraction;
    in property <string> memo-play-time;
    in-out property <int> memo-confirm: -1;
    in-out property <int> memo-editing: -1;
    // The speech model is on the computer: texts can be written.
    in property <bool> memo-can-write;
    in-out property <bool> memo-auto-text;
    in property <string> memo-message;
    // The big text view: open, for which memo, and what it shows.
    in-out property <bool> memo-sheet-open;
    in property <int> memo-sheet-index: -1;
    in property <string> memo-sheet-title;
    in property <string> memo-sheet-when;
    // The text field: the paragraphs, each with the stamp asked for.
    in-out property <string> memo-sheet-text;
    // What goes before each paragraph: 0 nothing, 1 how far into the memo,
    // 2 the time of day.
    in-out property <int> memo-sheet-stamps;
    // Every change is on disk.
    in property <bool> memo-sheet-saved: true;
    in-out property <bool> memo-copied;
    // A recording the user has not looked at yet: the dot on the main page.
    in property <bool> memo-new;
    callback memos-toggled(bool);
    callback memo-toggle-changed(bool);
    callback memo-auto-text-toggled(bool);
    callback memo-record();
    callback memo-open-list();
    callback memo-play(int);
    // Plays from the paragraph at this place of the text field (a byte offset).
    callback memo-play-here(int);
    // Where that paragraph starts, as 1:30; "" when it has no time.
    pure callback memo-here-label(string, int) -> string;
    callback memo-sheet-edited(string);
    callback memo-sheet-stamps-changed(int);
    callback memo-show(int);
    callback memo-delete(int);
    callback memo-rename(int, string);
    callback memo-write-text(int);
    callback memo-cancel-text(int);
    callback memo-show-text(int);
    callback memo-close-text();
    // The selection (byte offsets), or all when they are the same.
    callback memo-copy-text(int, int);
    callback memo-open-text();
    callback memo-search(string);
    callback memo-open-folder();

    // Own models (page 7): the user's language model reworks dictations,
    // the user's speech server can recognise them. Experimental: off, none
    // of it shows.
    in-out property <bool> own-models;
    callback own-models-toggled(bool);
    in-out property <string> rework-url;
    in-out property <string> rework-model;
    in-out property <string> rework-key;
    // The models the server offers, once it answered.
    in property <[string]> rework-models;
    in-out property <int> rework-model-index;
    // How the last test went; "" for nothing yet.
    in property <string> rework-note;
    in property <bool> rework-busy;
    // A server and model are set: the choice shows on the main page.
    in property <bool> rework-ready;
    // 0 off, 1 fix, 2 reword, 3 translate.
    in-out property <int> rework-index;
    // The language translations go into, in the order of `rework-targets`.
    in-out property <int> rework-target-index;
    callback rework-target-changed(int);
    in-out property <bool> asr-on;
    in-out property <string> asr-url;
    in-out property <string> asr-model;
    in-out property <string> asr-key;
    in property <[string]> asr-models;
    in-out property <int> asr-model-index;
    in property <string> asr-note;
    in property <bool> asr-busy;
    // Saves address, model and key, asks the server and tries it once.
    callback rework-connect();
    callback rework-model-picked(int);
    callback rework-changed(int);
    callback asr-toggled(bool);
    callback asr-connect();
    callback asr-model-picked(int);
    // What reworking can be, for the choices on the main page.
    out property <[string]> rework-options: [@tr("Off"), @tr("Fix mishearings"), @tr("Reword nicely"), @tr("Translate")];
    out property <[string]> rework-targets: [@tr("English"), @tr("German"), @tr("French"), @tr("Spanish"), @tr("Italian")];
}

// The tray has its own properties: globals are per component instance, so
// the app wires tray and window separately.
export component Tray inherits SystemTrayIcon {
    in property <bool> recording;
    in property <bool> active;
    in property <bool> filter-enabled;
    in property <bool> voice-enabled;
    in property <bool> dictation-enabled;
    in property <bool> dictation-ready;
    in property <string> key-name: "F9";
    in property <bool> memos-enabled;
    in property <bool> memo-recording;
    in property <string> memo-key-name;
    // A newer version found ("" for none).
    in property <string> update-version;
    // The user's language model is set up: what it does, 0 off, 1 fix,
    // 2 reword, 3 translate.
    in property <bool> rework-ready;
    in property <int> rework-index;
    in property <string> rework-target;
    callback rework-picked(int);
    callback open();
    callback toggle-memo();
    callback open-memos();
    callback install-update();
    callback toggle-filter();
    callback toggle-voice();
    callback toggle-dictation();
    callback quit();
    // No icon at all where kyrr's widget in Omarchy's bar stands in for it:
    // Slint registers the icon with the panel as soon as it has an image,
    // whatever `visible` says, so the image is what keeps it away.
    in property <bool> off;
    property <image> no-icon;
    visible: !root.off;
    icon: root.off ? root.no-icon : recording || memo-recording ? @image-url("icons/kyrr-recording-32.png") : active ? @image-url("icons/kyrr-32.png") : @image-url("icons/kyrr-off-32.png");
    tooltip: "kyrr · " + (root.memo-recording ? @tr("recording") + " · " : "")
        + (root.filter-enabled ? @tr("noise filter on") : @tr("noise filter off"))
        + (root.dictation-ready ? " · " + @tr("{} ready", root.key-name) : "")
        + (root.update-version != "" ? " · " + @tr("update available") : "");
    // Some panels list tray icons by title.
    title: "kyrr";
    clicked => { root.open(); }
    Menu {
        MenuItem {
            title: @tr("Open kyrr");
            activated => { root.open(); }
        }
        MenuItem {
            title: root.filter-enabled ? @tr("Isolate your voice: on") : @tr("Isolate your voice: off");
            activated => { root.toggle-filter(); }
        }
        MenuItem {
            title: root.voice-enabled ? @tr("Improve voice: on") : @tr("Improve voice: off");
            activated => { root.toggle-voice(); }
        }
        MenuItem {
            title: root.dictation-enabled ? @tr("Dictation: on") : @tr("Dictation: off");
            activated => { root.toggle-dictation(); }
        }
        if root.memos-enabled: MenuItem {
            title: (root.memo-recording ? @tr("Stop recording") : @tr("Start recording"))
                + (root.memo-key-name != "" ? " (" + root.memo-key-name + ")" : "");
            activated => { root.toggle-memo(); }
        }
        if root.memos-enabled: MenuItem {
            title: @tr("Open recordings");
            activated => { root.open-memos(); }
        }
        if root.rework-ready: Menu {
            title: @tr("Rework");
            MenuItem {
                title: (root.rework-index == 0 ? "✓ " : "") + @tr("Off");
                activated => { root.rework-picked(0); }
            }
            MenuItem {
                title: (root.rework-index == 1 ? "✓ " : "") + @tr("Fix mishearings");
                activated => { root.rework-picked(1); }
            }
            MenuItem {
                title: (root.rework-index == 2 ? "✓ " : "") + @tr("Reword nicely");
                activated => { root.rework-picked(2); }
            }
            MenuItem {
                title: (root.rework-index == 3 ? "✓ " : "") + root.rework-target;
                activated => { root.rework-picked(3); }
            }
        }
        if root.update-version != "": MenuItem {
            title: @tr("Install update {}", root.update-version);
            activated => { root.install-update(); }
        }
        MenuItem {
            title: @tr("Quit");
            activated => { root.quit(); }
        }
    }
}

component Caption inherits Text {
    color: Skin.foreground.with-alpha(0.65);
    font-size: 12px;
    wrap: word-wrap;
}

// A short, plain explanation of the option chosen above it.
component Hint inherits Text {
    // 0.7 keeps small text readable (contrast), still quieter than captions.
    color: Skin.foreground.with-alpha(0.7);
    font-size: 12px;
    wrap: word-wrap;
}

component Heading inherits Text {
    font-size: 15px;
    font-weight: 600;
}

component Card inherits Rectangle {
    background: Skin.alternate-background;
    border-radius: Skin.round(10px);
    border-width: Skin.card-frame;
    border-color: Skin.foreground.with-alpha(0.2);
    VerticalLayout {
        padding: 14px;
        spacing: 8px;
        @children
    }
}

component Separator inherits Rectangle {
    height: 1px;
    background: Skin.border.with-alpha(0.6);
}

// A row of choices, one selected. Tab focuses it, the arrow keys move the
// choice; screen readers hear each option as a radio button.
component Segmented inherits FocusScope {
    in property <[string]> options;
    in-out property <int> selected;
    // An option that cannot be picked (taken elsewhere); -1 for none.
    in property <int> unavailable: -1;
    callback changed(int);

    function choose(i: int) {
        if (root.enabled && i >= 0 && i < root.options.length && i != root.selected && i != root.unavailable) {
            root.selected = i;
            root.changed(i);
        }
    }

    // The next option that way, over one that cannot be picked.
    function step(by: int) {
        root.choose(root.selected + by == root.unavailable ? root.selected + 2 * by : root.selected + by);
    }

    key-pressed(event) => {
        if (event.text == Key.LeftArrow) {
            root.step(-1);
            return accept;
        }
        if (event.text == Key.RightArrow) {
            root.step(1);
            return accept;
        }
        return reject;
    }

    HorizontalLayout {
        spacing: 6px;
        for option[i] in root.options: Rectangle {
            height: 28px;
            border-radius: Skin.round(6px);
            background: i == root.selected ? Skin.accent-background : Skin.control-background;
            border-width: root.has-focus && i == root.selected ? 2px : 1px;
            border-color: root.has-focus && i == root.selected ? Skin.foreground : Skin.border;
            opacity: root.enabled && i != root.unavailable ? 1 : 0.4;
            accessible-role: radio-button;
            accessible-label: option;
            accessible-checkable: true;
            accessible-checked: i == root.selected;
            accessible-enabled: root.enabled && i != root.unavailable;
            accessible-action-default => { root.choose(i); }
            Text {
                text: option;
                color: i == root.selected ? Skin.accent-foreground : Skin.control-foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                enabled: root.enabled && i != root.unavailable;
                clicked => {
                    root.focus();
                    root.choose(i);
                }
            }
        }
    }
}

// Grey: what the microphone hears. Accent line: what apps get.
component Meter inherits Rectangle {
    in property <float> before;
    in property <float> after;
    height: 10px;
    border-radius: Skin.round(5px);
    background: Skin.control-background;
    border-width: 1px;
    border-color: Skin.border;
    Rectangle {
        x: 0;
        width: parent.width * clamp(root.before, 0, 1);
        height: parent.height;
        border-radius: Skin.round(5px);
        background: Skin.foreground.with-alpha(0.18);
        animate width { duration: 90ms; }
    }
    Rectangle {
        x: 0;
        y: (parent.height - self.height) / 2;
        width: parent.width * clamp(root.after, 0, 1);
        height: 4px;
        border-radius: Skin.round(2px);
        background: Skin.accent-background;
        animate width { duration: 90ms; }
    }
}

// A small wave in the logo's colour next to the status line: it sways
// slowly while kyrr works, barely breathes while it waits, and lies still
// when everything is off (then nothing is redrawn at all). It steps on a
// timer instead of every frame: a frame-by-frame wave kept a whole core of
// an older laptop busy redrawing the window. The sway follows the clock, not
// the number of ticks, so a late tick makes a bigger step instead of a
// stumble, and the bars' ends fade in by the pixel, so at a window scale of
// 100% they glide instead of hopping a pixel at a time.
component Pulse inherits Rectangle {
    in property <bool> working;
    in property <bool> waiting;
    // Nobody sees it while the window is hidden: no ticks then.
    in property <bool> shown;
    property <bool> moving: root.working || root.waiting;
    // Sways so far (1 = one full sway).
    property <float> phase: 0;
    property <duration> last-tick;
    Timer {
        interval: root.working ? 33ms : 66ms;
        running: root.moving && root.shown;
        triggered => {
            // A tick that comes much too late counts as at most a short step.
            root.phase = mod(root.phase + min((animation-tick() - root.last-tick) / 1ms, 100) / root.period, 1);
            root.last-tick = animation-tick();
        }
    }
    // The clock restarts with the movement, so a pause is not counted.
    changed moving => { root.last-tick = animation-tick(); }
    changed shown => { root.last-tick = animation-tick(); }
    // Milliseconds per sway; slow on purpose, this is kyrr after all.
    property <float> period: root.working ? 2200 : 4500;
    property <float> depth: root.working ? 1 : 0.3;
    property <color> tint: Skin.logo;
    property <float> alpha: root.moving ? 0.85 : 0.4;
    width: 14px;
    height: 16px;
    for bar[i] in 4: Rectangle {
        property <float> level: root.moving ? root.depth * (0.5 + 0.5 * sin(root.phase * 360deg + i * 75deg)) : 0;
        // The bar's height in pixels: whole pixels (an even number, so it
        // stays centred) as a solid middle, the rest as a fading pixel at
        // each end.
        property <float> size: 2 + 10 * self.level;
        property <float> middle: 2 * floor(self.size / 2);
        property <float> rest: (self.size - self.middle) / 2;
        x: i * 4px;
        width: 2px;
        height: root.height;
        Rectangle {
            y: (parent.height - self.height) / 2;
            height: parent.middle * 1px;
            background: root.tint.with-alpha(root.alpha);
        }
        Rectangle {
            y: (parent.height - parent.middle * 1px) / 2 - 1px;
            height: 1px;
            background: root.tint.with-alpha(root.alpha * parent.rest);
        }
        Rectangle {
            y: (parent.height + parent.middle * 1px) / 2;
            height: 1px;
            background: root.tint.with-alpha(root.alpha * parent.rest);
        }
    }
}

// What kyrr is up to right now, in one loose sentence under the name, small
// and in italics so it reads as a remark, not a setting. Long-lasting states
// rotate through a few phrases to pass the time; errors and setup stay put.
component StatusLine inherits HorizontalLayout {
    // The text lines up with the name and sits close under it (pulled up
    // into the page layout's spacing, less than the Setup button's height
    // needs); the wave follows right after it.
    padding-left: 38px;
    padding-top: -2px;
    padding-bottom: 2px;
    spacing: 8px;
    property <bool> working: AppState.mic-active || AppState.probe-state != ProbeState.idle || AppState.model-switching
        || AppState.dictation-state == DictationState.recording || AppState.dictation-state == DictationState.transcribing
        || AppState.dictation-state == DictationState.downloading || AppState.filter-state == FilterState.setting-up
        || AppState.memo-recording;
    property <bool> waiting: (AppState.filter-enabled || AppState.voice-enabled)
        && (AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking);
    Text {
        horizontal-stretch: 0;
        text: AppState.status-line();
        font-size: 12px;
        font-italic: true;
        color: Skin.foreground;
        opacity: AppState.phrase-visible ? 0.6 : 0;
        animate opacity { duration: 450ms; easing: ease-in-out; }
        wrap: word-wrap;
        vertical-alignment: top;
        // One line always, so the cards below do not move when it is empty;
        // two for a long message (Slint measures wrapped text in this row as
        // one line, so the room is made here).
        min-height: AppState.status-line().character-count > 44 ? 32px : 16px;
    }
    Pulse {
        working: root.working;
        waiting: root.waiting;
        shown: AppState.window-shown;
    }
    Rectangle { }
}

// A main function's name and its switch. The one-line state below it is a
// direct child of the card (see the note in MainWindow).
// The small gear that opens a card's own settings.
component GearButton inherits Rectangle {
    in property <string> label;
    callback clicked();
    width: 30px;
    height: 30px;
    border-radius: Skin.round(8px);
    background: touch.has-hover || key.has-focus ? Skin.foreground.with-alpha(0.12) : transparent;
    forward-focus: key;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { root.clicked(); }
    Image {
        source: @image-url("icons/gear.png");
        colorize: Skin.foreground.with-alpha(0.75);
        width: 18px;
        height: 18px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    key := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
        mouse-cursor: pointer;
    }
}

component RowHead inherits HorizontalLayout {
    in property <string> title;
    in property <bool> enabled: true;
    in-out property <bool> checked;
    // The gear's name; no name, no gear.
    in property <string> gear-label;
    callback toggled(bool);
    callback gear();
    spacing: 6px;
    Heading { text: root.title; vertical-alignment: center; }
    Rectangle { }
    if root.gear-label != "": VerticalLayout {
        alignment: center;
        GearButton { label: root.gear-label; clicked => { root.gear(); } }
    }
    Switch {
        checked <=> root.checked;
        enabled: root.enabled;
        label: root.title;
        toggled => { root.toggled(self.checked); }
    }
}

component NoiseCard inherits Card {
    property <bool> attached: AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking;
    RowHead {
        title: @tr("Isolate your voice");
        gear-label: @tr("Settings: {}", @tr("Isolate your voice"));
        gear => { AppState.open-page(2); }
        enabled: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
            && AppState.filter-state != FilterState.unsupported;
        checked <=> AppState.filter-enabled;
        toggled(on) => { AppState.filter-toggled(on); }
    }
    Caption {
        text: root.attached ? (AppState.filter-enabled ? @tr("Just your voice. Keyboard, fan and dog stay outside.") : @tr("Off. Your mic passes through as it is."))
            : AppState.filter-state == FilterState.detached ? @tr("Windows took kyrr off {} (an update, most likely).", AppState.attached-mic)
            : AppState.filter-state == FilterState.passthrough ? @tr("The filter could not start and passes the microphone through.")
            : AppState.filter-state == FilterState.not-attached ? @tr("No microphone set up yet.")
            : AppState.filter-state == FilterState.not-installed ? @tr("kyrr's audio filter is not installed. Please reinstall kyrr.")
            : AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("PipeWire is not running, and kyrr needs it. Dictation works.") : @tr("Not on ARM processors yet, sorry. Dictation works."))
            : AppState.filter-state == FilterState.setting-up ? @tr("Setting up… sound pauses for a moment.")
            : AppState.error-text;
    }
    if AppState.filter-state == FilterState.unsupported && AppState.pipewire-button: Button {
        text: @tr("Set up PipeWire");
        primary: true;
        clicked => { AppState.install-pipewire(); }
    }
    if AppState.filter-state == FilterState.unsupported && AppState.pipewire-note != "": Hint { text: AppState.pipewire-note; }
    if AppState.filter-state == FilterState.not-attached: Button {
        text: @tr("Set up microphone");
        primary: true;
        clicked => { AppState.change-microphone(); }
    }
    if AppState.filter-state == FilterState.detached: Button {
        text: @tr("Repair");
        primary: true;
        clicked => { AppState.repair(); }
    }
    if AppState.move-to != "" && AppState.move-unplugged: Hint { text: @tr("Your microphone is not plugged in."); }
    if AppState.move-to != "" && !AppState.move-unplugged: Hint {
        text: AppState.linux ? @tr("Your system uses another microphone now.") : @tr("Windows uses another microphone now.");
    }
    if AppState.move-to != "": Button {
        text: @tr("Use {} instead", AppState.move-to);
        clicked => { AppState.move-to-default(); }
    }
}

component VoiceCard inherits Card {
    property <bool> available: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
        && AppState.filter-state != FilterState.unsupported;
    RowHead {
        title: @tr("Improve voice");
        gear-label: @tr("Settings: {}", @tr("Improve voice"));
        gear => { AppState.open-page(3); }
        enabled: root.available;
        checked <=> AppState.voice-enabled;
        toggled(on) => { AppState.voice-toggled(on); }
    }
    Caption {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire too.") : @tr("Not on ARM processors yet either."))
            : !root.available ? @tr("Needs a microphone first.")
            : AppState.voice-enabled ? @tr("A bit of polish for your voice.")
            : @tr("Off. Your voice stays as it is.");
    }
}

component DictationCard inherits Card {
    // The setup asks for the key itself, below the card.
    in property <bool> in-setup;
    RowHead {
        title: @tr("Dictation");
        gear-label: root.in-setup ? "" : @tr("Settings: {}", @tr("Dictation"));
        gear => { AppState.open-page(4); }
        checked <=> AppState.dictation-enabled;
        toggled(on) => { AppState.dictation-toggled(on); }
    }
    Caption {
        text: AppState.dictation-state == DictationState.off ? @tr("Off. {} does nothing.", AppState.key-name)
            : AppState.dictation-state == DictationState.no-model ? @tr("One download first ({}), then it is yours.", AppState.download-size)
            : AppState.dictation-state == DictationState.downloading ? @tr("Downloading the speech model… {}%", round(AppState.download-progress * 100))
            : AppState.dictation-state == DictationState.loading ? @tr("Loading the speech model…")
            : AppState.dictation-state == DictationState.ready && AppState.key-unbound && !root.in-setup ? @tr("{} is not set up yet: kyrr needs your desktop's OK for it.", AppState.key-name)
            : AppState.dictation-state == DictationState.ready && AppState.key-note != "" && !root.in-setup ? @tr("Dictate with your key, the text lands at your cursor. Setting up the key: see the gear.")
            : AppState.dictation-state == DictationState.ready ? (AppState.key-toggle ? @tr("Tap {}, talk, tap again. The text lands at your cursor.", AppState.key-name) : @tr("Hold {}, talk, let go. The text lands at your cursor.", AppState.key-name))
            : AppState.dictation-state == DictationState.recording ? @tr("Listening…")
            : AppState.dictation-state == DictationState.transcribing ? @tr("Writing…")
            : AppState.dictation-message;
    }
    if AppState.dictation-state != DictationState.error && AppState.dictation-message != "": Hint {
        text: AppState.dictation-message;
    }
    if AppState.dictation-state == DictationState.error: Button {
        text: @tr("Try again");
        clicked => { AppState.dictation-retry(); }
    }
    if AppState.dictation-state == DictationState.ready && AppState.key-unbound && !root.in-setup: Button {
        text: AppState.key-button;
        primary: true;
        clicked => { AppState.key-button-clicked(); }
    }
    if AppState.dictation-state == DictationState.downloading: HorizontalLayout {
        spacing: 12px;
        VerticalLayout {
            alignment: center;
            ProgressIndicator { progress: AppState.download-progress; height: 6px; }
        }
        Button { text: @tr("Cancel"); clicked => { AppState.cancel-download(); } }
    }
    if AppState.dictation-state == DictationState.no-model: Button {
        text: @tr("Download");
        primary: true;
        clicked => { AppState.download-model(); }
    }
    if AppState.rework-ready && !root.in-setup && AppState.dictation-enabled: HorizontalLayout {
        spacing: 8px;
        Caption { text: @tr("Rework"); vertical-alignment: center; width: 30%; }
        ComboBox {
            model: AppState.rework-options;
            current-index <=> AppState.rework-index;
            selected => { AppState.rework-changed(self.current-index); }
        }
    }
    if AppState.rework-ready && !root.in-setup && AppState.dictation-enabled: HorizontalLayout {
        spacing: 8px;
        Caption { text: @tr("Translate into"); vertical-alignment: center; width: 30%; }
        ComboBox {
            model: AppState.rework-targets;
            current-index <=> AppState.rework-target-index;
            selected => { AppState.rework-target-changed(self.current-index); }
        }
    }
}

// One band of the custom sound: name, slider, value.
component BandRow {
    in property <string> label;
    in-out property <float> value;
    callback changed(float);
    HorizontalLayout {
        spacing: 8px;
        Caption { text: root.label; width: 64px; vertical-alignment: center; }
        Slider {
            minimum: -6;
            maximum: 6;
            step: 0.5;
            value <=> root.value;
            changed(v) => { root.changed(v); }
        }
        Caption {
            text: (root.value > 0 ? "+" : "") + round(root.value * 10) / 10 + " dB";
            width: 52px;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }
}

// Settings: the choices behind the noise switch.
component NoiseSettings inherits Card {
    pure function strength-hint(i: int) -> string {
        if (i == 0) { return @tr("Takes the worst out and leaves a bit of room. Natural."); }
        if (i == 1) { return @tr("The sweet spot for most rooms."); }
        return @tr("Out with everything but you. Bouncer mode.");
    }
    property <bool> attached: AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking;

    if !root.attached: Hint {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire, which is not running.") : @tr("Not on ARM processors yet, sorry.")) : @tr("Set up a microphone first.");
    }
    if root.attached: Caption { text: @tr("Filter strength"); }
    if root.attached: Segmented {
        options: [@tr("Gentle"), @tr("Medium"), @tr("Strong")];
        selected <=> AppState.strength-index;
        changed(i) => { AppState.strength-changed(i); }
    }
    if root.attached: Hint { text: root.strength-hint(AppState.strength-index); }
    if root.attached && AppState.old-cpu: Hint { text: @tr("This processor is a bit older: Lean runs smoother on it. Switch in Setup, under Effort."); }
}

// The standard key as a choice, and next to it a field: click in, press a
// key, and that key is taken. Escape or leaving the field gives up. A key of
// one's own stands in the field with "change" behind it, so it reads as
// something to click.
component KeyPicker inherits HorizontalLayout {
    in property <string> standard;
    in property <string> current;
    in property <bool> custom;
    // 1 dictation, 2 voice memos: which field this is.
    in property <int> slot;
    property <bool> listening: AppState.key-capture == root.slot;
    spacing: 6px;
    // The standard key, picked while no key of one's own is set.
    Rectangle {
        horizontal-stretch: 1;
        height: 28px;
        property <bool> picked: !root.custom && !root.listening;
        border-radius: Skin.round(6px);
        background: self.picked ? Skin.accent-background : Skin.control-background;
        border-width: 1px;
        border-color: Skin.border;
        accessible-role: radio-button;
        accessible-label: root.standard;
        accessible-checkable: true;
        accessible-checked: self.picked;
        accessible-action-default => { AppState.key-reset(root.slot); }
        Text {
            text: root.standard;
            color: parent.picked ? Skin.accent-foreground : Skin.control-foreground;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        TouchArea {
            clicked => { AppState.key-reset(root.slot); }
        }
    }
    field := FocusScope {
        horizontal-stretch: 1;
        focus-changed-event => {
            if (!self.has-focus && root.listening) {
                AppState.capture-key(0);
            }
        }
        // Without a mouse: Enter or Space on the focused field starts it.
        key-pressed(event) => {
            if (!root.listening && (event.text == Key.Return || event.text == " ")) {
                AppState.capture-key(root.slot);
                return accept;
            }
            return reject;
        }
        Rectangle {
            height: 28px;
            border-radius: Skin.round(6px);
            background: root.custom && !root.listening ? Skin.accent-background : Skin.control-background;
            border-width: root.listening || field.has-focus ? 2px : 1px;
            border-color: root.listening || field.has-focus ? Skin.foreground : Skin.border;
            accessible-role: button;
            accessible-label: @tr("Set key");
            accessible-description: root.custom ? root.current : "";
            accessible-action-default => { AppState.capture-key(root.slot); }
            Text {
                text: root.listening ? @tr("Press a key …")
                    : root.custom ? @tr("{} · change", root.current) : @tr("Set key");
                color: root.custom && !root.listening ? Skin.accent-foreground : Skin.control-foreground;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            TouchArea {
                clicked => {
                    field.focus();
                    AppState.capture-key(root.slot);
                }
            }
        }
    }
}

// Settings: the dictation key and how it works.
component DictationSettings inherits Card {
    Caption { text: @tr("Key"); }
    // Where the desktop owns the key, its own settings change it.
    if !AppState.key-fixed: KeyPicker {
        standard: "F9";
        current: AppState.key-name;
        custom: AppState.key-custom;
        slot: 1;
    }
    if !AppState.key-fixed && AppState.key-refusal != "": Hint { text: AppState.key-refusal; color: Skin.refusal; }
    if !AppState.key-fixed && AppState.key-warning != "": Hint { text: AppState.key-warning; }
    // Only where kyrr catches the key itself.
    if AppState.key-note == "": Hint { text: @tr("With Ctrl, Alt or Shift held, the key stays with your app."); }
    if AppState.key-note != "": Hint { text: AppState.key-note; }
    if AppState.key-button != "": Button {
        text: AppState.key-button;
        clicked => { AppState.key-button-clicked(); }
    }
    Caption { text: @tr("How"); }
    Segmented {
        options: [@tr("Hold"), @tr("Tap")];
        selected: AppState.key-toggle ? 1 : 0;
        changed(i) => { AppState.key-toggle-changed(i == 1); }
    }
    Hint {
        text: AppState.key-toggle ? @tr("Tap once to start, once more to stop. For long thoughts.")
            : @tr("Hold while you talk, let go when you are done. Walkie-talkie style.");
    }
    Hint { text: @tr("Say “new line” or “new paragraph” for line breaks."); }
}

// Settings: who made what.
component AboutSettings inherits Card {
    // The credits are folded away behind a button.
    in-out property <bool> unfolded;
    property <bool> credits: root.unfolded;
    Heading { text: @tr("About"); }
    // The models' credits, as their licenses ask. NVIDIA's sentence stays
    // in English in every language: the license gives it word for word.
    Hint { text: @tr("kyrr is mostly just very good at plugging things together. Built on the work of many."); }
    if root.credits: Hint { text: @tr("Noise removal: DPDFNet by Ceva (Apache-2.0), via Fovty's HushMic."); }
    if root.credits: Hint { text: @tr("German and multilingual dictation: parakeet-ultra by moondream (CC-BY-4.0), based on NVIDIA parakeet-tdt-0.6b-v3."); }
    if root.credits: Hint { text: @tr("English dictation: NVIDIA parakeet-unified-en-0.6b, Licensed by NVIDIA Corporation under the NVIDIA Open Model License; ONNX by sherpa-onnx."); }
    if root.credits: Hint { text: @tr("Plus the work of many more not named here. Raising a beer to you all."); }
    // Up to two rows: three buttons side by side overflow the card in German and
    // with wider system fonts, and the window has a fixed width.
    HorizontalLayout {
        spacing: 8px;
        Rectangle { }
        Button {
            text: root.unfolded ? @tr("Less") : @tr("Credits");
            clicked => { root.unfolded = !root.unfolded; }
        }
        Button { text: @tr("Feedback"); clicked => { AppState.send-feedback(); } }
    }
    HorizontalLayout {
        spacing: 8px;
        Rectangle { }
        Button { text: @tr("What's new"); clicked => { AppState.show-current-news(); } }
        Button { text: @tr("Licenses"); clicked => { AppState.open-licenses(); } }
    }
}

// One of the two effort choices in the setup: a card that lights up green
// when picked.
component EffortOption inherits Rectangle {
    in property <string> title;
    in property <string> text;
    in property <bool> picked;
    callback clicked();
    forward-focus: key;
    border-radius: Skin.round(10px);
    border-width: key.has-focus ? 2px : 1px;
    border-color: key.has-focus ? Skin.foreground : root.picked ? Skin.picked : Skin.border;
    background: root.picked ? Skin.picked.with-alpha(0.12) : (touch.has-hover ? Skin.alternate-background : transparent);
    accessible-role: radio-button;
    accessible-label: root.title + ". " + root.text;
    accessible-checkable: true;
    accessible-checked: root.picked;
    accessible-action-default => { root.clicked(); }
    // Tab reaches it, Space or Enter picks it, like the other choices.
    key := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
    HorizontalLayout {
        padding: 12px;
        spacing: 10px;
        VerticalLayout {
            alignment: start;
            padding-top: 2px;
            Rectangle {
                width: 14px;
                height: 14px;
                border-radius: Skin.round(7px);
                border-width: 1.5px;
                border-color: root.picked ? Skin.picked : Skin.foreground.with-alpha(0.4);
                Rectangle {
                    width: 8px;
                    height: 8px;
                    border-radius: Skin.round(4px);
                    background: Skin.picked;
                    visible: root.picked;
                }
            }
        }
        VerticalLayout {
            spacing: 3px;
            Text { text: root.title; font-size: 13px; font-weight: 700; }
            Text { text: root.text; font-size: 12px; wrap: word-wrap; color: Skin.foreground.with-alpha(0.75); }
        }
    }
}

// A short note on the main page that stays until it is closed.
component NoteBanner inherits Rectangle {
    in property <string> text;
    callback closed();
    background: Skin.warning.with-alpha(0.12);
    border-color: Skin.warning.with-alpha(0.45);
    border-width: 1px;
    border-radius: Skin.round(10px);
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: Skin.round(4px); background: Skin.warning; }
        }
        Text {
            text: root.text;
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 24px;
            horizontal-stretch: 0;
            forward-focus: close-key;
            border-width: close-key.has-focus ? 2px : 0px;
            border-color: Skin.foreground;
            border-radius: Skin.round(4px);
            accessible-role: button;
            accessible-label: @tr("Close");
            accessible-action-default => { root.closed(); }
            close-key := FocusScope {
                key-pressed(event) => {
                    if (event.text == " " || event.text == Key.Return) {
                        root.closed();
                        return accept;
                    }
                    return reject;
                }
            }
            Text {
                // × (not ✕): every font has it.
                text: "×";
                font-size: 20px;
                color: close.has-hover ? Skin.foreground : Skin.foreground.with-alpha(0.55);
            }
            close := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.closed(); }
            }
        }
    }
}

// The main view's quiet note that a new version is out, with the one click
// that installs it. Closing it hides it until the next version.
component UpdateBanner inherits Rectangle {
    property <bool> busy: AppState.update-state == UpdateState.downloading || AppState.update-state == UpdateState.installing;
    background: Skin.picked.with-alpha(0.12);
    border-color: Skin.picked.with-alpha(0.45);
    border-width: 1px;
    border-radius: Skin.round(10px);
    HorizontalLayout {
        padding: 8px;
        padding-left: 12px;
        spacing: 8px;
        VerticalLayout {
            alignment: center;
            Rectangle { width: 8px; height: 8px; border-radius: Skin.round(4px); background: Skin.picked; }
        }
        Text {
            text: AppState.update-state == UpdateState.downloading ? @tr("Downloading the update… {}%", round(AppState.update-progress * 100))
                : AppState.update-state == UpdateState.installing ? @tr("Installing, kyrr restarts in a moment.")
                : AppState.update-state == UpdateState.download-failed ? @tr("The update did not download.")
                : @tr("Version {} is out.", AppState.update-version);
            font-size: 12px;
            wrap: word-wrap;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
        if !root.busy && AppState.update-has-news: Button {
            text: @tr("What's new");
            horizontal-stretch: 0;
            clicked => { AppState.show-news(); }
        }
        if !root.busy && AppState.update-installable: Button {
            text: AppState.update-state == UpdateState.download-failed ? @tr("Try again") : @tr("Update");
            primary: true;
            horizontal-stretch: 0;
            clicked => { AppState.install-update(); }
        }
        if !root.busy && !AppState.update-installable: Button {
            text: @tr("Download page");
            horizontal-stretch: 0;
            clicked => { AppState.open-update(); }
        }
        if !root.busy: Rectangle {
            width: 24px;
            horizontal-stretch: 0;
            forward-focus: close-key;
            border-width: close-key.has-focus ? 2px : 0px;
            border-color: Skin.foreground;
            border-radius: Skin.round(4px);
            accessible-role: button;
            accessible-label: @tr("Not now");
            accessible-action-default => { AppState.dismiss-update(); }
            close-key := FocusScope {
                key-pressed(event) => {
                    if (event.text == " " || event.text == Key.Return) {
                        AppState.dismiss-update();
                        return accept;
                    }
                    return reject;
                }
            }
            Text {
                // × (not ✕): every font has it.
                text: "×";
                font-size: 20px;
                color: close.has-hover ? Skin.foreground : Skin.foreground.with-alpha(0.55);
            }
            close := TouchArea {
                mouse-cursor: pointer;
                clicked => { AppState.dismiss-update(); }
            }
        }
    }
}

// Sends the window away; everything else keeps running in the tray.
// A button in warning red, for something that is running and should not be
// forgotten.
component AlertButton inherits Rectangle {
    in property <string> text;
    callback clicked();
    forward-focus: key;
    min-height: 32px;
    min-width: label.preferred-width + 24px;
    border-radius: Skin.round(4px);
    border-width: key.has-focus ? 2px : 0px;
    border-color: Skin.foreground;
    background: touch.pressed ? Skin.danger-pressed : touch.has-hover ? Skin.danger-hover : Skin.danger;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }
    key := FocusScope {
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    label := Text {
        text: root.text;
        color: white;
        font-size: 13px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
}

// The small red note at the bottom of the main page. Always one line high,
// empty or not, so the window keeps its height however many notes there are.
component AlertLine inherits Text {
    text: AppState.alert-note();
    // The red notes are problems; a microphone coming back is good news.
    color: AppState.alert == 7 ? Skin.good : Skin.bad;
    font-size: 12px;
    min-height: 16px;
    vertical-alignment: center;
    overflow: elide;
    // The mute note stays; the others take turns.
    opacity: (AppState.phrase-visible || AppState.alert == 4 || AppState.alert == 6 || AppState.alert == 7) ? 1 : 0;
    animate opacity { duration: 450ms; easing: ease-in-out; }
}

component HideRow inherits HorizontalLayout {
    spacing: 8px;
    Button {
        text: @tr("Quit");
        horizontal-stretch: 0;
        clicked => { AppState.quit-app(); }
    }
    Hint {
        // Only a warning: where neither a tray nor minimizing exists
        // (tiling desktops), closing the window quits kyrr.
        text: AppState.tray || AppState.can-minimize ? "" : @tr("No tray here: closing the window quits kyrr.");
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    // Where there is neither a tray nor a minimizing desktop (Hyprland
    // without a bar tray), the button would do nothing: it stays away.
    if AppState.tray || AppState.can-minimize: Button {
        text: @tr("Off to the corner");
        horizontal-stretch: 0;
        clicked => { AppState.hide(); }
    }
}

// Settings: everything about how the voice sounds.
component VoiceSettings inherits Card {
    pure function look-hint(i: int) -> string {
        if (i == 1) { return @tr("A bit more belly, less edge. Cosy."); }
        if (i == 2) { return @tr("Takes the boxiness out, speech moves forward."); }
        if (i == 3) { return @tr("More sparkle on top. Rescues dull mics."); }
        if (i == 4) { return @tr("Your own mix. Kept when you switch back and forth."); }
        return @tr("No make-up. Your voice as it is.");
    }
    pure function compressor-hint(i: int) -> string {
        if (i == 1) { return @tr("Smooths a little. You will hardly notice, your listeners will."); }
        if (i == 2) { return @tr("Quiet words come through better. Good for calls."); }
        if (i == 3) { return @tr("Nearly constant volume. For streams and noisy rooms."); }
        return @tr("Loud stays loud, quiet stays quiet. As nature intended.");
    }
    pure function deesser-hint(i: int) -> string {
        if (i == 1) { return @tr("Takes the edge off hissing S sounds."); }
        if (i == 2) { return @tr("Tames S and SH clearly. Good for bright mics."); }
        if (i == 3) { return @tr("Heavy. Can sound lispy close to the mic."); }
        return @tr("S sounds stay as they are.");
    }
    property <bool> shown: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
        && AppState.filter-state != FilterState.unsupported && AppState.voice-enabled;

    if !root.shown: Hint {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire, which is not running.") : @tr("Not on ARM processors yet, sorry."))
            : @tr("Voice is off, so there is nothing to turn. Switch it on in the main view.");
    }
    if root.shown: Caption { text: @tr("Sound"); }
    if root.shown: Segmented {
        options: [@tr("Neutral"), @tr("Warm"), @tr("Clear"), @tr("Bright"), @tr("Custom")];
        selected <=> AppState.look-index;
        changed(i) => { AppState.look-changed(i); }
    }
    if root.shown: Hint { text: root.look-hint(AppState.look-index); }
    if root.shown && AppState.look-index == 4: VerticalLayout {
        spacing: 2px;
        BandRow {
            label: @tr("Body");
            value <=> AppState.body-db;
            changed(v) => { AppState.band-changed(0, v); }
        }
        BandRow {
            label: @tr("Presence");
            value <=> AppState.presence-db;
            changed(v) => { AppState.band-changed(1, v); }
        }
        BandRow {
            label: @tr("Air");
            value <=> AppState.air-db;
            changed(v) => { AppState.band-changed(2, v); }
        }
    }
    if root.shown: Caption { text: @tr("Compressor"); }
    if root.shown: Segmented {
        options: [@tr("Off"), @tr("Light"), @tr("Medium"), @tr("Strong")];
        selected <=> AppState.compressor-index;
        changed(i) => { AppState.compressor-changed(i); }
    }
    if root.shown: Hint { text: root.compressor-hint(AppState.compressor-index); }
    if root.shown: Caption { text: @tr("Soften S sounds"); }
    if root.shown: Segmented {
        options: [@tr("Off"), @tr("Light"), @tr("Medium"), @tr("Strong")];
        selected <=> AppState.deesser-index;
        changed(i) => { AppState.deesser-changed(i); }
    }
    if root.shown: Hint { text: root.deesser-hint(AppState.deesser-index); }
    if root.shown: HorizontalLayout {
        Caption { text: @tr("Cut low rumble"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.low-cut;
            toggled => { AppState.low-cut-toggled(self.checked); }
        }
    }
    if root.shown: Hint {
        text: AppState.low-cut ? @tr("Swallows footsteps, desk bumps and wind below {} Hz.", AppState.look-index == 3 ? 100 : 80)
            : @tr("Off. Rumble, wind and desk bumps get through.");
    }
    if root.shown: HorizontalLayout {
        Caption { text: @tr("Pop protection"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.pops;
            toggled => { AppState.pops-toggled(self.checked); }
        }
    }
    if root.shown: Hint {
        text: AppState.pops ? @tr("Takes the thump out of P and B when you are close to the mic.")
            : @tr("Off. P and B can thump.");
    }
    if root.shown: HorizontalLayout {
        Caption { text: @tr("Distance compensation"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.distance;
            toggled => { AppState.distance-toggled(self.checked); }
        }
    }
    if root.shown: Hint {
        text: AppState.distance ? @tr("Far from the mic, it takes some of the room's echo out. Close up, it does nothing.")
            : @tr("Off. Far from the mic, the room echoes along.");
    }
    if root.shown && !AppState.voice-is-default: HorizontalLayout {
        Rectangle { }
        Button { text: @tr("Reset"); clicked => { AppState.voice-reset(); } }
    }
}

// Settings: the automatic volume, a choice of its own: it works with or
// without the voice shaping. The page shows what it does right now.
component LevelSettings inherits Card {
    property <bool> available: AppState.filter-state != FilterState.not-attached && AppState.filter-state != FilterState.not-installed
        && AppState.filter-state != FilterState.unsupported;
    property <int> gain: round(AppState.level-gain);
    RowHead {
        title: @tr("Automatic volume");
        enabled: root.available;
        checked <=> AppState.auto-level;
        toggled(on) => { AppState.auto-level-toggled(on); }
    }
    Hint {
        text: AppState.filter-state == FilterState.unsupported ? (AppState.linux ? @tr("Needs PipeWire, which is not running.") : @tr("Not on ARM processors yet, sorry."))
            : !root.available ? @tr("Set up a microphone first.")
            : AppState.auto-level ? @tr("Always the same volume, however your mic is set. If your call app does that too, switch one off.")
            : (AppState.linux ? @tr("Off. Your mic as loud as your system sets it.") : @tr("Off. Your mic as loud as Windows sets it."));
    }
    // What it adds right now: green when it boosts, red when it cuts.
    property <string> signed: root.gain > 0 ? "+" + root.gain : root.gain < 0 ? "−" + (-root.gain) : "0";
    if root.available && AppState.auto-level: Caption {
        text: !AppState.mic-active ? @tr("Shows what it evens out while an app uses the mic.")
            : root.gain == 0 ? @tr("Right now unchanged: your mic is just right.")
            : @tr("Right now: {} dB", root.signed);
        color: !AppState.mic-active || root.gain == 0 ? Skin.foreground.with-alpha(0.65)
            : root.gain > 0 ? Skin.good : Skin.bad;
    }
}

// Settings: the level meter and the before/after test.
component ToolsSettings inherits Card {
    property <bool> attached: AppState.filter-state == FilterState.running || AppState.filter-state == FilterState.checking;
    property <bool> busy: AppState.probe-state != ProbeState.idle;
    // Level and test come from the filter; listening works without it.
    property <bool> filter: AppState.filter-state != FilterState.unsupported;

    Heading { text: @tr("Check"); }
    if root.filter: Meter {
        before: AppState.level-before;
        after: AppState.level-after;
        opacity: AppState.mic-active ? 1 : 0.4;
    }
    if root.filter: HorizontalLayout {
        spacing: 6px;
        alignment: start;
        Rectangle { width: 10px; height: 10px; y: 3px; border-radius: Skin.round(5px); background: Skin.foreground.with-alpha(0.18); }
        Hint { text: @tr("your mic"); horizontal-stretch: 0; }
        Rectangle { width: 14px; }
        Rectangle { width: 14px; height: 4px; y: 6px; border-radius: Skin.round(2px); background: Skin.accent-background; }
        Hint { text: @tr("what your apps get"); horizontal-stretch: 0; }
    }
    if root.filter: Hint { text: @tr("Moves while an app uses the mic."); }
    if root.filter: HorizontalLayout {
        Button {
            text: @tr("Test: before / after");
            enabled: root.attached && !root.busy && !AppState.listening;
            clicked => { AppState.probe-record(); }
        }
        Rectangle { }
    }
    if AppState.has-probe: HorizontalLayout {
        spacing: 6px;
        Button {
            text: @tr("Before");
            enabled: !root.busy;
            clicked => { AppState.probe-play(false); }
        }
        Button {
            text: @tr("After");
            enabled: !root.busy;
            clicked => { AppState.probe-play(true); }
        }
        Rectangle { }
        Button {
            text: @tr("Delete");
            enabled: !root.busy;
            clicked => { AppState.probe-reset(); }
        }
    }
    if root.filter: Hint { text: @tr("Records ten seconds, then compare. Nothing is saved."); }
    HorizontalLayout {
        if !AppState.listening: Button {
            text: @tr("Listen to yourself");
            enabled: !root.busy;
            clicked => { AppState.listen-toggled(); }
        }
        if AppState.listening: AlertButton {
            text: @tr("Stop listening");
            clicked => { AppState.listen-toggled(); }
        }
        Rectangle { }
    }
    Hint { text: @tr("Your mic live in your headphones, the way your apps hear it. On speakers it squeals."); }
    if AppState.probe-error != "": Caption { text: AppState.probe-error; color: Skin.bad; }
}

// Settings: the rest.
component GeneralSettings inherits Card {
    pure function effort-hint(i: int) -> string {
        if (i == 0) { return @tr("Simpler noise removal, no live text: the words show once you are done talking. Dictations up to 2 minutes. Typed just as well. For older laptops."); }
        if (i == 1) { return @tr("The most thorough noise removal and live text: the words show while you talk. Dictations up to 15 minutes. Needs a bit more power."); }
        return @tr("Your own mix of noise removal and live text.");
    }
    Caption { text: @tr("Effort"); }
    Segmented {
        options: AppState.effort-index == 2 ? [@tr("Lean"), @tr("Best quality"), @tr("Custom")] : [@tr("Lean"), @tr("Best quality")];
        selected <=> AppState.effort-index;
        changed(i) => { AppState.effort-changed(i); }
    }
    Hint { text: root.effort-hint(AppState.effort-index); }
    HorizontalLayout {
        Caption { text: @tr("Overload protection"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.auto-lean;
            toggled => { AppState.auto-lean-toggled(self.checked); }
        }
    }
    Hint {
        text: AppState.auto-lean ? @tr("If the computer cannot keep up, kyrr switches to Lean by itself.")
            : @tr("Off: when overloaded, the microphone may stutter and noise removal may pause.");
    }
    Separator { }
    HorizontalLayout {
        spacing: 8px;
        Caption { text: @tr("Language"); vertical-alignment: center; }
        Segmented {
            options: ["Deutsch", "English", @tr("Multilingual")];
            selected <=> AppState.language-index;
            changed(i) => { AppState.language-changed(i); }
        }
    }
    Hint {
        text: AppState.language-index == 2 ? @tr("Multilingual: French, Spanish, Italian, Dutch, Polish, Portuguese and more. kyrr notices the language by itself. German and English can be a bit less precise, and it needs its own download.")
            : @tr("Also the language dictation listens for.");
    }
    Separator { }
    HorizontalLayout {
        Caption { text: @tr("Live text"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.live-words;
            toggled => { AppState.live-words-toggled(self.checked); }
        }
    }
    Hint {
        text: AppState.live-words ? @tr("The display at the bottom of the screen shows what kyrr hears as you speak.")
            : @tr("Off. The display shows only the bars; the text comes when you are done.");
    }
    Separator { }
    HorizontalLayout {
        Caption { text: (AppState.linux ? @tr("Start when you sign in") : @tr("Start with Windows")); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.autostart;
            toggled => { AppState.autostart-toggled(self.checked); }
        }
    }
    Separator { }
    HorizontalLayout {
        Caption { text: @tr("Check for updates automatically"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.update-auto;
            toggled => { AppState.update-auto-toggled(self.checked); }
        }
    }
    Hint {
        text: AppState.update-auto ? @tr("kyrr asks GitHub once a day. Nothing about you is sent, installing is always your click.")
            : @tr("kyrr only asks GitHub when you click.");
    }
    HorizontalLayout {
        Rectangle { }
        Button {
            text: @tr("Check for updates");
            enabled: AppState.update-state != UpdateState.checking && AppState.update-state != UpdateState.downloading
                && AppState.update-state != UpdateState.installing;
            clicked => { AppState.check-updates(); }
        }
    }
    if (AppState.update-state == UpdateState.checking): Hint { text: @tr("Having a look…"); }
    if (AppState.update-state == UpdateState.current): Hint { text: @tr("You have the newest version. Nothing to do."); }
    if (AppState.update-state == UpdateState.failed): Hint { text: @tr("Could not check right now. Offline?"); }
    // Text and button separately: wrapped text inside a nested layout
    // under `if` is measured as one line.
    if (AppState.update-state == UpdateState.available && AppState.update-installable): Hint {
        text: @tr("Version {} is out. One click and kyrr updates itself, your settings stay.", AppState.update-version);
    }
    if (AppState.update-state == UpdateState.available && !AppState.update-installable): Hint {
        text: (AppState.linux ? @tr("Version {} is out. Update kyrr where you installed it from, your settings stay.", AppState.update-version) : @tr("Version {} is out. Download it and run the installer, your settings stay.", AppState.update-version));
    }
    if (AppState.update-state == UpdateState.download-failed): Hint {
        text: @tr("The download did not work. Try again, or get it from the download page.");
    }
    if (AppState.update-state == UpdateState.available || AppState.update-state == UpdateState.download-failed): HorizontalLayout {
        spacing: 8px;
        Rectangle { }
        Button {
            text: @tr("Download page");
            clicked => { AppState.open-update(); }
        }
        if AppState.update-installable: Button {
            text: @tr("Update now");
            primary: true;
            clicked => { AppState.install-update(); }
        }
    }
    if (AppState.update-state == UpdateState.downloading): Hint {
        text: @tr("Downloading the update… {}%", round(AppState.update-progress * 100));
    }
    if (AppState.update-state == UpdateState.downloading): ProgressIndicator { progress: AppState.update-progress; height: 6px; }
    if (AppState.update-state == UpdateState.installing): Hint {
        text: @tr("Installing. Windows asks for permission once, then kyrr restarts by itself.");
    }
    if AppState.filter-state != FilterState.unsupported: Separator { }
    if AppState.filter-state != FilterState.unsupported: HorizontalLayout {
        spacing: 8px;
        Caption { text: AppState.attached-mic != "" ? AppState.attached-mic : @tr("Microphone"); horizontal-stretch: 1; vertical-alignment: center; }
        Button { text: @tr("Change microphone"); clicked => { AppState.change-microphone(); } }
    }
    Separator { }
    HorizontalLayout {
        Caption { text: @tr("Own models (experimental)"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.own-models;
            toggled => { AppState.own-models-toggled(self.checked); }
        }
    }
    Hint {
        text: AppState.own-models ? @tr("A language model or speech server on this computer or in your home network. Still an experiment: may change or go again.")
            : @tr("Off. For a language model or speech server of your own; kyrr needs none.");
    }
    if AppState.own-models: HorizontalLayout {
        Rectangle { }
        Button { text: @tr("Set up"); clicked => { AppState.open-page(7); } }
    }
}

// Settings: the user's language model, which reworks dictations.
component ReworkSettings inherits Card {
    Heading { text: @tr("Rework"); }
    Hint { text: @tr("A language model on this computer or in your home network fixes, rewords or translates what you dictate. Needs a program like Ollama or LM Studio."); }
    Caption { text: @tr("Address"); }
    LineEdit {
        placeholder-text: "http://192.168.1.10:11434";
        text <=> AppState.rework-url;
    }
    Caption { text: @tr("Model"); }
    if AppState.rework-models.length > 0: ComboBox {
        model: AppState.rework-models;
        current-index <=> AppState.rework-model-index;
        selected => { AppState.rework-model-picked(self.current-index); }
    }
    if AppState.rework-models.length == 0: LineEdit {
        placeholder-text: @tr("Filled in once the server answers");
        text <=> AppState.rework-model;
    }
    Caption { text: @tr("Key, if the server wants one"); }
    LineEdit {
        input-type: password;
        text <=> AppState.rework-key;
    }
    HorizontalLayout {
        Rectangle { }
        Button {
            text: AppState.rework-busy ? @tr("Asking…") : @tr("Connect and test");
            primary: true;
            enabled: !AppState.rework-busy;
            clicked => { AppState.rework-connect(); }
        }
    }
    if AppState.rework-note != "": Hint { text: AppState.rework-note; }
    if AppState.rework-ready: Hint { text: @tr("What it does: on the main page, under Dictation. Press the key while it works and your words come as you said them."); }
}

// Settings: dictation through the user's own speech server.
component SpeechServerSettings inherits Card {
    Heading { text: @tr("Dictation model"); }
    Segmented {
        options: [@tr("Built in"), @tr("Own server")];
        selected: AppState.asr-on ? 1 : 0;
        changed(i) => { AppState.asr-toggled(i == 1); }
    }
    Hint {
        text: AppState.asr-on ? @tr("A speech server in your home network recognises what you say (speaches, whisper.cpp and the like). No live text then. If the server is away, kyrr recognises here, if the speech model is on this computer.")
            : @tr("kyrr recognises on this computer. Nothing leaves it.");
    }
    if AppState.asr-on: Caption { text: @tr("Address"); }
    if AppState.asr-on: LineEdit {
        placeholder-text: "http://192.168.1.10:8000";
        text <=> AppState.asr-url;
    }
    if AppState.asr-on: Caption { text: @tr("Model"); }
    if AppState.asr-on && AppState.asr-models.length > 0: ComboBox {
        model: AppState.asr-models;
        current-index <=> AppState.asr-model-index;
        selected => { AppState.asr-model-picked(self.current-index); }
    }
    if AppState.asr-on && AppState.asr-models.length == 0: LineEdit {
        placeholder-text: @tr("Filled in once the server answers");
        text <=> AppState.asr-model;
    }
    if AppState.asr-on: Caption { text: @tr("Key, if the server wants one"); }
    if AppState.asr-on: LineEdit {
        input-type: password;
        text <=> AppState.asr-key;
    }
    if AppState.asr-on: HorizontalLayout {
        Rectangle { }
        Button {
            text: AppState.asr-busy ? @tr("Asking…") : @tr("Connect and test");
            primary: true;
            enabled: !AppState.asr-busy;
            clicked => { AppState.asr-connect(); }
        }
    }
    if AppState.asr-on && AppState.asr-note != "": Hint { text: AppState.asr-note; }
}

component SetupPage inherits VerticalLayout {
    in property <int> step;
    // Linux without PipeWire: the first step offers to set it up instead.
    property <bool> no-pipewire: AppState.linux && AppState.filter-state == FilterState.unsupported
        && (AppState.pipewire-button || AppState.pipewire-note != "");
    spacing: 12px;
    // Every element carries its own `if`: Slint measures wrapped text
    // wrongly inside a nested layout that is itself conditional.
    if step == 0: Hint { text: @tr("Step 1 of 3"); }
    if step == 0: Heading { text: @tr("Welcome to kyrr"); font-size: 20px; }
    if step == 0: Caption {
        text: root.no-pipewire ? @tr("kyrr removes background noise from your microphone, for every app. For that it needs PipeWire, the sound system of modern Linux desktops, which is missing here.")
            : @tr("kyrr removes background noise from your microphone, for every app. Which microphone do you use?");
    }
    if step == 0 && root.no-pipewire && AppState.pipewire-button: Button {
        text: @tr("Set up PipeWire");
        primary: true;
        clicked => { AppState.install-pipewire(); }
    }
    if step == 0 && root.no-pipewire && AppState.pipewire-note != "": Hint { text: AppState.pipewire-note; }
    if step == 0 && !root.no-pipewire: ComboBox {
        model: AppState.microphones;
        current-index <=> AppState.mic-index;
    }
    if step == 0 && !root.no-pipewire: Caption { text: (AppState.linux ? @tr("kyrr adds a microphone called “kyrr” and makes it the default. Apps set to a particular microphone need to be switched to “kyrr”.") : @tr("Windows will ask for permission. Sound pauses for a moment while kyrr sets up.")); }
    if step == 0 && !root.no-pipewire: Button {
        text: AppState.filter-state == FilterState.setting-up ? @tr("Setting up…") : @tr("Set up microphone");
        primary: true;
        enabled: AppState.filter-state != FilterState.setting-up && AppState.microphones.length > 0;
        clicked => { AppState.attach-microphone(AppState.mic-index); }
    }
    if step == 0 && AppState.filter-state == FilterState.error: Caption { text: AppState.error-text; color: Skin.bad; }
    if step == 0: Button {
        text: @tr("Not now, just dictation");
        enabled: AppState.filter-state != FilterState.setting-up;
        clicked => { AppState.skip-setup(); }
    }

    if step == 1: Hint { text: @tr("Step 2 of 3"); }
    if step == 1: Heading { text: @tr("Language and dictation model"); font-size: 20px; }
    if step == 1: Caption {
        text: AppState.key-note == "" || AppState.guide ? @tr("Hold {} and speak. When you let go, kyrr types what you said, in any app. It runs on your computer, nothing is sent anywhere.", AppState.key-name)
            : @tr("Start dictation with a key and speak. When you end it, kyrr types what you said, in any app. It runs on your computer, nothing is sent anywhere.");
    }
    if step == 1: Caption { text: @tr("Language"); }
    if step == 1: Segmented {
        options: ["Deutsch", "English", @tr("Multilingual")];
        selected <=> AppState.language-index;
        changed(i) => { AppState.language-changed(i); }
    }
    if step == 1: DictationCard { in-setup: true; }
    if step == 1 && AppState.key-note != "" && !AppState.guide: Hint { text: AppState.key-note; }
    // The desktop's questions, one at a time, each said before it comes.
    if step == 1 && AppState.guide: Caption {
        text: AppState.key-state == 0 ? @tr("Dictation uses {}. Your desktop has to allow that once: click below, then “Add” in its window.", AppState.key-name)
            : AppState.key-state == 1 ? @tr("Now click “Add” in your desktop's window: the blue button at its top right. {} is already filled in, the pencil is not needed.", AppState.key-name)
            : AppState.key-state == 3 ? @tr("{} is not set up yet: the window was closed without “Add”. Try again?", AppState.key-name)
            : AppState.key-tried ? @tr("✓ {} works.", AppState.key-name)
            : @tr("✓ {} is set up. Try it: press {} once.", AppState.key-name, AppState.key-name);
    }
    if step == 1 && AppState.guide && (AppState.key-state == 0 || AppState.key-state == 3): Button {
        text: AppState.key-state == 0 ? @tr("Set up {}", AppState.key-name) : @tr("Try again");
        primary: true;
        clicked => { AppState.setup-key(); }
    }
    if step == 1 && AppState.guide && AppState.key-state == 2: Caption {
        text: AppState.typing-state == 0 ? @tr("Last step: kyrr types your words into other apps. Your desktop asks once (“Remote Desktop”): switch on “Allow Remote Interaction”, then click “Share”.")
            : AppState.typing-state == 1 ? @tr("In your desktop's window: switch on “Allow Remote Interaction” (its only switch), then click “Share”, the blue button at the top right.")
            : AppState.typing-state == 3 ? @tr("Not allowed, so kyrr cannot type for you. Try again?")
            : @tr("✓ kyrr may type.");
    }
    if step == 1 && AppState.guide && AppState.key-state == 2 && (AppState.typing-state == 0 || AppState.typing-state == 3): Button {
        text: AppState.typing-state == 0 ? @tr("Allow typing") : @tr("Try again");
        primary: true;
        clicked => { AppState.allow-typing(); }
    }
    if step == 1: Button {
        text: @tr("Next");
        primary: AppState.dictation-state != DictationState.no-model
            && (!AppState.guide || (AppState.key-state == 2 && AppState.typing-state == 2));
        clicked => { AppState.next-setup(); }
    }

    if step == 2: Hint { text: @tr("Step 3 of 3"); }
    if step == 2: Heading { text: @tr("Performance setting"); font-size: 20px; }
    if step == 2: Caption { text: @tr("How much may kyrr ask of your computer?"); }
    if step == 2: EffortOption {
        title: @tr("Best quality");
        text: @tr("For most computers. The most thorough noise removal and live text: the words show while you talk. Dictations up to 15 minutes.");
        picked: AppState.effort-index == 1;
        clicked => { AppState.effort-index = 1; AppState.effort-changed(1); }
    }
    if step == 2: EffortOption {
        title: @tr("Lean");
        text: @tr("For older or weaker laptops, and if things stutter. Simpler noise removal, no live text: the words show once you are done talking. Dictations up to 2 minutes.");
        picked: AppState.effort-index == 0;
        clicked => { AppState.effort-index = 0; AppState.effort-changed(0); }
    }
    if step == 2: Hint { text: @tr("Typed just as well either way. You can switch any time in the settings."); }
    if step == 2: Hint { text: (AppState.linux ? @tr("kyrr starts when you sign in and lives in the tray, if your desktop has one. Both can be changed in the settings.") : @tr("kyrr starts with Windows and lives in the tray, bottom right (maybe behind the little arrow). Both can be changed in the settings.")); }
    if step == 2: Button {
        text: @tr("Done");
        primary: true;
        clicked => { AppState.finish-setup(); }
    }
}

// What is new in the version on offer: a small window of its own with the
// summary the release brings, in plain words.
export component NewsWindow inherits Window {
    in property <string> version;
    in property <string> news;
    // 0: the version on offer, 1: the one that just got installed, 2: all of them.
    in property <int> mode;
    callback close();
    title: @tr("What's new");
    background: Skin.background;
    default-font-family: Skin.font;
    icon: @image-url("icons/kyrr-256.png");
    preferred-width: 380px;
    min-width: 320px;
    preferred-height: 320px;
    VerticalLayout {
        padding: 18px;
        spacing: 12px;
        Heading {
            text: root.mode == 2 ? @tr("What's new in kyrr")
                : root.mode == 1 ? @tr("What kyrr {} brings", root.version)
                : @tr("kyrr {} is out", root.version);
            font-size: 18px;
        }
        ScrollView {
            VerticalLayout {
                alignment: start;
                width: parent.visible-width;
                Text {
                    text: root.news;
                    wrap: word-wrap;
                    font-size: 13px;
                }
            }
        }
        HorizontalLayout {
            Rectangle { }
            Button {
                text: @tr("Close");
                primary: true;
                horizontal-stretch: 0;
                clicked => { root.close(); }
            }
        }
    }
}

// Small drawn icons (16 × 16), so no icon font has to be on the system.
global Shapes {
    out property <string> play: "M 4 2 L 14 8 L 4 14 Z";
    out property <string> stop: "M 3 3 L 13 3 L 13 13 L 3 13 Z";
    out property <string> pen: "M 11 1.5 L 14.5 5 L 5.5 14 L 1.5 14.5 L 2 10.5 Z";
    out property <string> folder: "M 1 3 L 6 3 L 7.5 4.5 L 15 4.5 L 15 13.5 L 1 13.5 Z";
    out property <string> bin: "M 2 3 L 14 3 L 14 4.5 L 2 4.5 Z M 6 1 L 10 1 L 10 3 L 6 3 Z M 3.5 5.5 L 12.5 5.5 L 11.5 15 L 4.5 15 Z";
}

// A round button with a drawn icon; `label` is what screen readers hear.
component IconButton inherits Rectangle {
    in property <string> shape;
    in property <string> label;
    in property <bool> enabled: true;
    in property <color> tint: Skin.foreground.with-alpha(0.8);
    in property <length> size: 28px;
    callback clicked();
    forward-focus: key;
    width: root.size;
    height: root.size;
    border-radius: Skin.round(root.size / 2);
    border-width: key.has-focus ? 2px : 0px;
    border-color: Skin.foreground;
    background: !root.enabled ? transparent : touch.pressed ? Skin.foreground.with-alpha(0.16)
        : touch.has-hover ? Skin.foreground.with-alpha(0.08) : transparent;
    opacity: root.enabled ? 1 : 0.35;
    accessible-role: button;
    accessible-label: root.label;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    key := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    Path {
        x: (root.width - self.width) / 2;
        y: (root.height - self.height) / 2;
        width: root.size / 2;
        height: root.size / 2;
        viewbox-width: 16;
        viewbox-height: 16;
        commands: root.shape;
        fill: root.tint;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// A small rounded text button inside a memo's row.
component Chip inherits Rectangle {
    in property <string> text;
    in property <bool> enabled: true;
    in property <bool> strong;
    in property <bool> danger;
    callback clicked();
    forward-focus: key;
    height: 24px;
    width: label.preferred-width + 18px;
    border-radius: Skin.round(12px);
    border-width: key.has-focus ? 2px : 0px;
    border-color: Skin.foreground;
    background: root.danger ? (touch.has-hover ? Skin.danger-hover : Skin.danger)
        : root.strong ? Skin.accent-background
        : touch.has-hover && root.enabled ? Skin.foreground.with-alpha(0.13) : Skin.foreground.with-alpha(0.07);
    opacity: root.enabled ? 1 : 0.5;
    accessible-role: button;
    accessible-label: root.text;
    accessible-action-default => { if (root.enabled) { root.clicked(); } }
    key := FocusScope {
        enabled: root.enabled;
        key-pressed(event) => {
            if (event.text == " " || event.text == Key.Return) {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
    label := Text {
        text: root.text;
        font-size: 12px;
        color: root.danger ? white : root.strong ? Skin.accent-foreground : Skin.foreground;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    touch := TouchArea {
        enabled: root.enabled;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// The voice memo on the main page: a switch, how it works, and the buttons.
component RecordingCard inherits Card {
    // The memo key is held while it records, as chosen under the gear.
    property <bool> hold: !AppState.memo-toggle && AppState.memo-can-hold;
    RowHead {
        title: @tr("Voice memo");
        gear-label: AppState.memos-enabled ? @tr("Settings: {}", @tr("Voice memo")) : "";
        gear => { AppState.open-page(5); }
        checked <=> AppState.memos-enabled;
        toggled(on) => { AppState.memos-toggled(on); }
    }
    Caption {
        text: !AppState.memos-enabled ? @tr("Off. Your recordings stay where they are.")
            : AppState.memo-recording ? (AppState.memo-key-name == "" ? @tr("Recording. The button ends it.")
                : root.hold ? @tr("Recording. Let go of {} or press the button to end it.", AppState.memo-key-name)
                : @tr("Recording. {} or the button ends it.", AppState.memo-key-name))
            : AppState.memo-key-name == "" ? @tr("Record under Recordings or in the tray. kyrr saves and names the recording by itself.")
            : root.hold ? @tr("Hold {}, talk, let go. kyrr saves and names the recording by itself.", AppState.memo-key-name)
            : @tr("Tap {}, talk, tap again. kyrr saves and names the recording by itself.", AppState.memo-key-name);
    }
    if AppState.memos-enabled: HorizontalLayout {
        spacing: 8px;
        // Started with the key; only a running one gets a button here.
        if AppState.memo-recording: AlertButton {
            text: "■ " + @tr("Stop") + "  " + AppState.memo-elapsed;
            horizontal-stretch: 0;
            clicked => { AppState.memo-record(); }
        }
        Rectangle { }
        // A recording not looked at yet, as on a phone: the dot goes when
        // the list was opened.
        if AppState.memo-new: VerticalLayout {
            alignment: center;
            horizontal-stretch: 0;
            Rectangle {
                width: 10px;
                height: 10px;
                border-radius: Skin.round(5px);
                background: Skin.accent-background;
                accessible-role: text;
                accessible-label: @tr("New recording");
            }
        }
        Button {
            text: @tr("Recordings");
            horizontal-stretch: 0;
            clicked => { AppState.memo-open-list(); }
        }
    }
    if AppState.memos-enabled && AppState.memo-message != "": Hint { text: AppState.memo-message; }
}

// One memo in the list: title and date, the buttons, and while something
// runs (its text, playing, a question) one more line.
component MemoRow inherits Rectangle {
    in property <MemoItem> item;
    in property <int> index;
    property <bool> playing: AppState.memo-playing == root.index;
    property <bool> editing: AppState.memo-editing == root.index;
    property <bool> confirming: AppState.memo-confirm == root.index;
    property <bool> busy: root.item.text-state == 1 || root.item.text-state == 2;
    background: Skin.alternate-background;
    border-radius: Skin.round(10px);
    VerticalLayout {
        padding: 8px;
        padding-left: 6px;
        spacing: 4px;
        HorizontalLayout {
            spacing: 4px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    shape: root.playing ? Shapes.stop : Shapes.play;
                    label: root.playing ? @tr("Stop") : @tr("Play");
                    tint: Skin.accent-background;
                    clicked => { AppState.memo-play(root.index); }
                }
            }
            VerticalLayout {
                spacing: 0px;
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    if !root.editing: Text {
                        text: root.item.pending ? @tr("Finding a title…") : root.item.title;
                        font-size: 13px;
                        font-weight: 600;
                        font-italic: root.item.pending;
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 0;
                    }
                    if !root.editing && !root.item.pending && !root.busy: IconButton {
                        shape: Shapes.pen;
                        label: @tr("Rename");
                        size: 22px;
                        clicked => {
                            AppState.memo-confirm = -1;
                            AppState.memo-editing = root.index;
                        }
                    }
                    if root.editing: FocusScope {
                        height: edit.preferred-height;
                        horizontal-stretch: 1;
                        key-pressed(event) => {
                            if (event.text == Key.Escape) {
                                AppState.memo-editing = -1;
                                return accept;
                            }
                            return reject;
                        }
                        edit := LineEdit {
                            width: parent.width;
                            text: root.item.title;
                            font-size: 13px;
                            accessible-label: @tr("Title");
                            init => {
                                self.focus();
                                self.select-all();
                            }
                            accepted(text) => {
                                AppState.memo-editing = -1;
                                AppState.memo-rename(root.index, text);
                            }
                        }
                    }
                    if !root.editing: Rectangle { horizontal-stretch: 1; }
                    IconButton {
                        shape: Shapes.folder;
                        label: @tr("Show in folder");
                        clicked => { AppState.memo-show(root.index); }
                    }
                    IconButton {
                        shape: Shapes.bin;
                        label: @tr("Delete");
                        enabled: !root.item.pending;
                        clicked => {
                            AppState.memo-editing = -1;
                            AppState.memo-confirm = root.confirming ? -1 : root.index;
                        }
                    }
                }
                HorizontalLayout {
                    spacing: 6px;
                    Text {
                        text: root.playing ? AppState.memo-play-time : root.item.when;
                        font-size: 12px;
                        color: Skin.foreground.with-alpha(0.65);
                        overflow: elide;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    if root.item.text-state == 3: Chip {
                        text: @tr("Show text");
                        strong: true;
                        clicked => { AppState.memo-show-text(root.index); }
                    }
                    if (root.item.text-state == 0 || root.item.text-state == 4) && !root.item.pending: Chip {
                        text: @tr("Write text");
                        enabled: AppState.memo-can-write;
                        clicked => { AppState.memo-write-text(root.index); }
                    }
                    // The row keeps its height without a button.
                    if root.item.pending || root.busy: Rectangle { height: 24px; width: 0px; }
                }
            }
        }
        if root.playing: Rectangle {
            height: 3px;
            border-radius: Skin.round(1.5px);
            background: Skin.foreground.with-alpha(0.1);
            Rectangle {
                x: 0;
                width: parent.width * clamp(AppState.memo-play-fraction, 0, 1);
                border-radius: Skin.round(1.5px);
                background: Skin.accent-background;
            }
        }
        if root.busy: HorizontalLayout {
            spacing: 8px;
            padding-left: 32px;
            Text {
                text: root.item.text-state == 1 ? @tr("Waiting for its turn…")
                    : root.item.text-left != "" ? @tr("Writing… {}% · {}", round(root.item.text-progress * 100), root.item.text-left)
                    : @tr("Writing… {}%", round(root.item.text-progress * 100));
                font-size: 12px;
                color: Skin.foreground.with-alpha(0.7);
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Chip {
                text: @tr("Cancel");
                clicked => { AppState.memo-cancel-text(root.index); }
            }
        }
        if root.busy: Rectangle {
            height: 4px;
            border-radius: Skin.round(2px);
            background: Skin.foreground.with-alpha(0.1);
            Rectangle {
                x: 0;
                width: parent.width * clamp(root.item.text-progress, 0, 1);
                border-radius: Skin.round(2px);
                background: Skin.good;
                animate width { duration: 400ms; easing: ease-out; }
            }
        }
        if root.item.text-state == 4: Text {
            text: AppState.memo-can-write ? @tr("That did not work. Try again?") : @tr("Needs the speech model: download it under Dictation.");
            font-size: 12px;
            color: Skin.bad;
            wrap: word-wrap;
        }
        if root.confirming: HorizontalLayout {
            spacing: 8px;
            padding-left: 32px;
            Text {
                text: @tr("Delete for good?");
                font-size: 12px;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            Chip {
                text: @tr("Keep");
                clicked => { AppState.memo-confirm = -1; }
            }
            Chip {
                text: @tr("Delete");
                danger: true;
                clicked => {
                    AppState.memo-confirm = -1;
                    AppState.memo-delete(root.index);
                }
            }
        }
    }
}

// The list of voice memos: the folder Documents/kyrr, newest first.
component MemosPage inherits VerticalLayout {
    spacing: 10px;
    HorizontalLayout {
        spacing: 10px;
        Button {
            text: @tr("← Back");
            horizontal-stretch: 0;
            clicked => {
                AppState.memo-editing = -1;
                AppState.memo-confirm = -1;
                AppState.page = 0;
                AppState.page-changed();
            }
        }
        Heading { text: @tr("Recordings"); font-size: 20px; vertical-alignment: center; }
        Rectangle { }
    }
    HorizontalLayout {
        spacing: 8px;
        if !AppState.memo-recording: Button {
            text: "● " + (AppState.memo-key-name != "" ? @tr("New recording ({})", AppState.memo-key-name) : @tr("New recording"));
            primary: true;
            horizontal-stretch: 0;
            clicked => { AppState.memo-record(); }
        }
        if AppState.memo-recording: AlertButton {
            text: "■ " + @tr("Stop") + "  " + AppState.memo-elapsed;
            horizontal-stretch: 0;
            clicked => { AppState.memo-record(); }
        }
        Rectangle { }
        Button {
            text: @tr("Open folder");
            horizontal-stretch: 0;
            clicked => { AppState.memo-open-folder(); }
        }
    }
    if AppState.memo-message != "": Hint { text: AppState.memo-message; }
    if AppState.memo-count > 0: LineEdit {
        placeholder-text: @tr("Search titles and texts");
        text <=> AppState.memo-query;
        edited(text) => { AppState.memo-search(text); }
    }
    for item[i] in AppState.memo-items: MemoRow {
        item: item;
        index: i;
    }
    if AppState.memo-count == 0: Caption {
        text: @tr("Nothing said yet. The folder is waiting.");
        horizontal-alignment: center;
    }
    if AppState.memo-count > 0 && AppState.memo-items.length == 0: Caption {
        text: @tr("Nothing found. Maybe said differently?");
        horizontal-alignment: center;
    }
}

// Settings: the voice memo's key, its text and where the memos are.
component RecordingSettings inherits Card {
    in property <string> folder;
    Caption { text: @tr("Key"); }
    if !AppState.key-fixed: KeyPicker {
        standard: "F8";
        current: AppState.memo-key-label;
        custom: AppState.memo-key-custom;
        slot: 2;
    }
    if !AppState.key-fixed && AppState.key-refusal != "": Hint { text: AppState.key-refusal; color: Skin.refusal; }
    if !AppState.key-fixed && AppState.key-warning != "": Hint { text: AppState.key-warning; }
    if AppState.memo-key-note != "": Hint { text: AppState.memo-key-note; color: Skin.refusal; }
    // Where the desktop owns the key, its own settings change it.
    if AppState.key-fixed: Hint { text: @tr("Your desktop sets this key, now {}.", AppState.memo-key-label); }
    if AppState.key-fixed && AppState.key-button != "": Button {
        text: AppState.key-button;
        clicked => { AppState.key-button-clicked(); }
    }
    Caption { text: @tr("How"); }
    if AppState.memo-can-hold: Segmented {
        options: [@tr("Hold"), @tr("Tap")];
        selected: AppState.memo-toggle ? 1 : 0;
        changed(i) => { AppState.memo-toggle-changed(i == 1); }
    }
    Hint {
        text: AppState.memo-toggle || !AppState.memo-can-hold ? @tr("Tap once to start, once more to stop. Dictation keeps {}.", AppState.key-name)
            : @tr("Hold while you talk, let go when you are done. Dictation keeps {}.", AppState.key-name);
    }
    Separator { }
    HorizontalLayout {
        Caption { text: @tr("Write the text after every recording"); vertical-alignment: center; }
        Rectangle { }
        Switch {
            checked <=> AppState.memo-auto-text;
            toggled => { AppState.memo-auto-text-toggled(self.checked); }
        }
    }
    Hint {
        text: AppState.memo-auto-text ? @tr("kyrr writes down every new recording right away. Long ones take a while on slow laptops.")
            : @tr("Off. A recording gets its text with a click.");
    }
    Separator { }
    HorizontalLayout {
        spacing: 8px;
        Caption { text: @tr("Saved in the folder kyrr in {}", root.folder); vertical-alignment: center; horizontal-stretch: 1; }
        Button { text: @tr("Open folder"); clicked => { AppState.memo-open-folder(); } }
    }
    Hint { text: @tr("About 11 MB per hour, everything stays on your computer. Only record conversations when everyone agrees."); }
}

// A memo's text, big: it slides up over the list and back down. One text
// field: it scrolls, takes a selection, and what is typed is saved.
component TranscriptSheet inherits Rectangle {
    in property <bool> open;
    background: Skin.background;
    // Clicks stay here, not in the list below.
    TouchArea { }
    changed open => {
        if (self.open) {
            input.focus();
        }
    }
    property <bool> playing: AppState.memo-playing == AppState.memo-sheet-index && AppState.memo-sheet-index >= 0;
    // Where the paragraph at the cursor starts ("" when it has no time).
    property <string> here: AppState.memo-here-label(AppState.memo-sheet-text, input.cursor-position-byte-offset);
    VerticalLayout {
        padding: 18px;
        spacing: 10px;
        HorizontalLayout {
            spacing: 8px;
            Button {
                text: @tr("← Back");
                horizontal-stretch: 0;
                clicked => { AppState.memo-close-text(); }
            }
            Rectangle { }
            Button {
                text: AppState.memo-copied ? "✓ " + @tr("Copied") : @tr("Copy");
                horizontal-stretch: 0;
                clicked => { AppState.memo-copy-text(input.cursor-position-byte-offset, input.anchor-position-byte-offset); }
            }
            Button {
                text: @tr("Open as text file");
                horizontal-stretch: 0;
                clicked => { AppState.memo-open-text(); }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            VerticalLayout {
                alignment: center;
                IconButton {
                    shape: root.playing ? Shapes.stop : Shapes.play;
                    label: root.playing ? @tr("Stop") : @tr("Play");
                    tint: Skin.accent-background;
                    size: 34px;
                    clicked => { AppState.memo-play(AppState.memo-sheet-index); }
                }
            }
            VerticalLayout {
                spacing: 2px;
                alignment: center;
                Heading { text: AppState.memo-sheet-title; font-size: 17px; overflow: elide; }
                Text {
                    text: root.playing ? AppState.memo-play-time : AppState.memo-sheet-when;
                    font-size: 12px;
                    color: Skin.foreground.with-alpha(0.65);
                }
            }
        }
        HorizontalLayout {
            spacing: 8px;
            Text {
                text: @tr("Times");
                font-size: 12px;
                color: Skin.foreground.with-alpha(0.65);
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
            Segmented {
                options: [@tr("Off"), @tr("Position"), @tr("Time of day")];
                selected <=> AppState.memo-sheet-stamps;
                changed(i) => { AppState.memo-sheet-stamps-changed(i); }
                horizontal-stretch: 0;
                min-width: 230px;
            }
            Rectangle { }
            Text {
                text: AppState.memo-sheet-saved ? "✓ " + @tr("Saved") : @tr("Saving …");
                font-size: 12px;
                color: Skin.foreground.with-alpha(0.65);
                vertical-alignment: center;
                horizontal-stretch: 0;
            }
        }
        Rectangle {
            background: Skin.alternate-background;
            border-radius: Skin.round(10px);
            border-width: input.has-focus ? 2px : 0px;
            border-color: Skin.accent-background;
            vertical-stretch: 1;
            scroll := ScrollView {
                x: 12px;
                y: 12px;
                width: parent.width - 24px;
                height: parent.height - 24px;
                content-width: self.visible-width;
                content-height: max(self.visible-height, input.preferred-height);
                input := TextInput {
                    text <=> AppState.memo-sheet-text;
                    single-line: false;
                    wrap: word-wrap;
                    font-size: 15px;
                    color: Skin.foreground;
                    selection-background-color: Skin.accent-background;
                    selection-foreground-color: Skin.accent-foreground;
                    page-height: scroll.visible-height;
                    accessible-label: AppState.memo-sheet-title;
                    edited => { AppState.memo-sheet-edited(self.text); }
                    key-pressed(event) => {
                        if (event.text == Key.Escape) {
                            AppState.memo-close-text();
                            return accept;
                        }
                        // The stamps never go onto the clipboard.
                        if (event.modifiers.control && (event.text == "c" || event.text == "C")
                            && self.cursor-position-byte-offset != self.anchor-position-byte-offset) {
                            AppState.memo-copy-text(self.cursor-position-byte-offset, self.anchor-position-byte-offset);
                            return accept;
                        }
                        return reject;
                    }
                    // Keeps the cursor in view while typing and moving.
                    cursor-position-changed(cpos) => {
                        if (cpos.y + scroll.content-y < 0px) {
                            scroll.content-y = min(0px, -cpos.y);
                        } else if (cpos.y + scroll.content-y > scroll.visible-height - 24px) {
                            scroll.content-y = min(0px, max(scroll.visible-height - self.height, scroll.visible-height - cpos.y - 24px));
                        }
                    }
                }
            }
            if AppState.memo-sheet-text == "": Caption {
                x: 14px;
                y: 14px;
                width: parent.width - 28px;
                text: @tr("Nothing understood in there. Was it quiet?");
            }
        }
        HorizontalLayout {
            spacing: 10px;
            Button {
                text: root.playing ? "■ " + @tr("Stop") : "▶ " + @tr("Play from here") + (root.here != "" ? " (" + root.here + ")" : "");
                primary: true;
                enabled: root.playing || root.here != "";
                horizontal-stretch: 0;
                clicked => {
                    if (root.playing) {
                        AppState.memo-play(AppState.memo-sheet-index);
                    } else {
                        AppState.memo-play-here(input.cursor-position-byte-offset);
                    }
                }
            }
            Hint {
                text: @tr("Select and copy: the times stay behind. What you type is saved by itself.");
                vertical-alignment: center;
            }
        }
    }
}

export component MainWindow inherits Window {
    in property <bool> setup-mode;
    in property <int> setup-step;
    // The height the content wants; the app caps the window and scrolls.
    out property <length> content-height: layout.preferred-height;
    callback content-height-changed();
    // The window came up (from the tray, at start); the app starts the meter.
    callback shown();
    changed content-height => { root.content-height-changed(); }
    // One column, 380 px, on every page; the recordings are wider, so a
    // text reads comfortably.
    out property <length> page-width: memos-page ? 520px : 380px;
    title: "kyrr";
    icon: @image-url("icons/kyrr-256.png");
    background: Skin.background;
    default-font-family: Skin.font;
    preferred-width: page-width;
    // A fixed width also keeps the window floating on tiling compositors
    // (Hyprland treats it like a dialog), which suits a small tool.
    min-width: page-width;
    max-width: page-width;
    // The main page has one height, fixed: its content's. The settings page
    // can be dragged taller or shorter and scrolls.
    // Other pages: the height the app picked (Linux only). Floating Wayland
    // compositors honour a minimum size, not a resize.
    in property <length> fit-height: 0px;
    // The same height as a maximum for a moment, so a compositor that keeps
    // its own idea of the size (Hyprland) lets the window shrink too.
    in property <bool> fit-hold;
    min-height: main-page ? layout.preferred-height : root.fit-height;
    max-height: main-page ? layout.preferred-height : root.fit-hold ? root.fit-height : 16384px;

    // A new page starts at the top, not where the last one was scrolled to.
    public function reset-scroll() {
        scroll.content-y = 0;
    }

    // Dark, whatever Windows says. Only for the README screenshots: the
    // headless preview has no system theme to follow.
    public function use-dark-scheme() {
        Palette.color-scheme = ColorScheme.dark;
    }

    // Omarchy's theme is dark or light: the system's controls follow it.
    public function use-scheme(dark: bool) {
        Palette.color-scheme = dark ? ColorScheme.dark : ColorScheme.light;
    }

    property <bool> main-page: !setup-mode && AppState.page == 0;
    property <bool> settings-page: !setup-mode && ((AppState.page >= 1 && AppState.page <= 5) || AppState.page == 7);
    property <bool> memos-page: !setup-mode && AppState.page == 6;
    property <string> page-title: AppState.page == 2 ? @tr("Isolate your voice")
        : AppState.page == 3 ? @tr("Improve voice")
        : AppState.page == 4 ? @tr("Dictation")
        : AppState.page == 5 ? @tr("Voice memo")
        : AppState.page == 7 ? @tr("Own models")
        : @tr("Setup");
    // Where the memos are, as the user knows the folder.
    in property <string> memo-folder;

    scroll := ScrollView {
        content-width: self.visible-width;
        content-height: layout.preferred-height;
        layout := VerticalLayout {
            width: scroll.visible-width;
            padding: 18px;
            spacing: 12px;
            // Direct children, not a nested layout in an `if`: Slint then
            // measures wrapped text at its real width.
            if setup-mode: SetupPage { step: root.setup-step; }

            // Main view: the status line and the three switches.
            if main-page: HorizontalLayout {
                spacing: 10px;
                Image { source: @image-url("icons/kyrr-256.png"); width: 28px; height: 28px; }
                Heading { text: "kyrr"; font-size: 20px; vertical-alignment: center; }
                Rectangle { }
                Button {
                    text: @tr("Setup");
                    horizontal-stretch: 0;
                    clicked => {
                        AppState.open-page(1);
                    }
                }
            }
            if main-page: StatusLine { }
            if main-page: NoiseCard { }
            if main-page: VoiceCard { }
            if main-page: DictationCard { }
            if main-page: RecordingCard { }
            if main-page && !AppState.update-dismissed && (AppState.update-state == UpdateState.available
                || AppState.update-state == UpdateState.downloading || AppState.update-state == UpdateState.installing
                || AppState.update-state == UpdateState.download-failed): UpdateBanner { }
            if main-page && AppState.overload-note != OverloadNote.none: NoteBanner {
                text: AppState.overload-note == OverloadNote.switched ? @tr("The computer could not keep up: now Lean.")
                    : @tr("The computer cannot keep up: noise removal pauses now and then.");
                closed => { AppState.overload-note = OverloadNote.none; }
            }
            if main-page: HorizontalLayout {
                spacing: 8px;
                AlertLine { }
                if AppState.alert == 4: Text {
                    text: @tr("Switch it on");
                    color: Skin.bad;
                    font-size: 12px;
                    font-weight: 700;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                    forward-focus: unmute-key;
                    accessible-role: button;
                    accessible-action-default => { AppState.unmute(); }
                    unmute-key := FocusScope {
                        key-pressed(event) => {
                            if (event.text == " " || event.text == Key.Return) {
                                AppState.unmute();
                                return accept;
                            }
                            return reject;
                        }
                    }
                    TouchArea { clicked => { AppState.unmute(); } mouse-cursor: pointer; }
                }
            }
            // With kyrr's widget in Omarchy's bar, the window is only
            // kyrr's settings: the widget opens and quits it.
            if main-page && !AppState.widget: HideRow { }

            // Settings pages: global, then one for each card's gear.
            if settings-page: HorizontalLayout {
                spacing: 10px;
                Button {
                    text: @tr("← Back");
                    horizontal-stretch: 0;
                    clicked => {
                        // Own models were opened from the general settings.
                        AppState.page = AppState.page == 7 ? 1 : 0;
                        AppState.page-changed();
                    }
                }
                Heading { text: root.page-title; font-size: 20px; vertical-alignment: center; }
                Rectangle { }
            }
            if settings-page && AppState.page == 1: GeneralSettings { }
            if settings-page && AppState.page == 1: ToolsSettings { }
            if settings-page && AppState.page == 1: AboutSettings { }
            if settings-page && AppState.page == 2: NoiseSettings { }
            if settings-page && AppState.page == 3: VoiceSettings { }
            if settings-page && AppState.page == 3: LevelSettings { }
            if settings-page && AppState.page == 4: DictationSettings { }
            if settings-page && AppState.page == 5: RecordingSettings { folder: root.memo-folder; }
            if settings-page && AppState.page == 7: ReworkSettings { }
            if settings-page && AppState.page == 7: SpeechServerSettings { }
            if memos-page: MemosPage { }
            if settings-page && AppState.page == 1: Caption {
                // English in every language, on purpose.
                text: "Proudly presented by heast13 and Claude “Silent but deadly” Opus. No microphones were harmed.";
                horizontal-alignment: center;
                font-size: 12px;
                font-italic: true;
            }
            if settings-page && AppState.page == 1: Caption {
                text: "kyrr " + AppState.version + (AppState.linux ? " Beta" : "");
                horizontal-alignment: center;
                font-size: 12px;
            }
        }
    }

    // A memo's text, slid up over the list.
    TranscriptSheet {
        open: memos-page && AppState.memo-sheet-open;
        x: 0;
        y: self.open ? 0 : root.height;
        width: root.width;
        height: root.height;
        opacity: self.open ? 1 : 0;
        visible: self.opacity > 0.01;
        animate y { duration: 280ms; easing: cubic-bezier(0.22, 1, 0.36, 1); }
        animate opacity { duration: 220ms; easing: ease-out; }
    }
}
